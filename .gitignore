# Dependencies and build output
# No trailing slash on `node_modules`: a worktree whose dependencies are a
# *symlink* to another checkout is not a directory to git, so `node_modules/`
# does not match it and `git add -A` commits a symlink into node_modules.
node_modules
dist/
.astro/
.output/
.wrangler/
worker-configuration.d.ts

# Generated by tooling, not source
# emdash-env.d.ts IS committed: it is the generated CMS type surface the app
# typechecks against, and reproducing it requires a database.

# Visual QA output — regenerate with `npm run check:visual`
screenshots/

# Browser-driven review scratch — accessibility snapshots and page dumps written
# by the MCP browser while inspecting a rendered route. Evidence, not source.
.playwright-mcp/

# Environment and secrets
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
*.log
*.swp
engine/state/
