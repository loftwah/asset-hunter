{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asset-hunter",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// No `migrations_dir`: this project has no hand-written SQL migrations.
	// EmDash's migrations are deployment-managed and recorded in
	// `.emdash/migrations.json` — see docs/DEPLOY.md. Declaring a directory
	// that does not exist would make `wrangler d1 migrations apply` look
	// configured while having nothing to apply.
	//
	// The real production database, created by `wrangler d1 create asset-hunter`.
	// A placeholder would have failed at deploy time instead of failing here,
	// which is why `npm run doctor` checks this field is set and not "local".
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "asset-hunter",
			"database_id": "b86b8b0d-bd3a-4331-856b-84e841370bc4"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "asset-hunter-media"
		}
	],
	// The canonical product URL, matching the subdomain pattern every other
	// project on this zone uses (fighter., bubbles., shoalshot., woodhouse.).
	// Without this the Worker is only reachable at its `workers.dev` name and
	// `assets.loftwah.com` — the URL in `astro.config.mjs`, the seed and every
	// canonical link the site emits — answers 522.
	"routes": [{ "pattern": "assets.loftwah.com", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
