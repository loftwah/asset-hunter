{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asset-hunter",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "asset-hunter",
			"database_id": "local",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "asset-hunter-media"
		}
	]
}
