{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asset-hunter",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// `database_id: "local"` is what keeps local work off production. There is
	// no `migrations_dir` here either — EmDash migrations are managed by
	// EmDash, not by SQL files in this repository.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "asset-hunter",
			"database_id": "local"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "asset-hunter-media"
		}
	]
}
