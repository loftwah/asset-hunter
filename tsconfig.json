{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		// @cloudflare/workers-types supplies `ExportedHandler` and the rest of
		// the Workers runtime globals used by src/worker.ts.
		"types": ["node", "@cloudflare/workers-types"],
		"strictNullChecks": true
	},
	"include": [
		"src",
		// The hunt engine is a separate process with its own composition root
		// (`engine/src/runtime/root.ts`), but it is still TypeScript in this
		// repository and it still has to typecheck. It was only being checked by
		// accident, through `tests/engine.test.ts` importing the pure modules —
		// which meant `engine/src/cli.ts`, the program's only edge, was compiled by
		// Node and never by a type checker. #62 made that omission expensive.
		"engine/src",
		".astro/types.d.ts",
		"emdash-env.d.ts",
		"worker-configuration.d.ts",
		"tests",
		"scripts"
	],
	"exclude": ["dist", "node_modules"]
}
