{
	"name": "asset-hunter",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Asset Hunter — a discovery engine for creative and technical possibilities.",
	"emdash": {
		"seed": "seed/seed.json"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "npm@10.9.8",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev --config dist/server/wrangler.json",
		"deploy": "astro build && wrangler deploy",
		"typecheck": "astro check",
		"emdash": "emdash",
		"seed": "seed/seed.json",
		"seed:build": "node scripts/build-seed.mjs",
		"seed:check": "node scripts/build-seed.mjs --check",
		"seed:validate": "emdash seed seed/seed.json --validate",
		"types": "emdash types",
		"doctor": "node scripts/doctor.mjs",
		"smoke": "node scripts/emdash-smoke.mjs",
		"test": "node --test tests/*.test.ts",
		"test:unit": "node --test tests/catalogue.test.ts tests/seed.test.ts tests/engine.test.ts",
		"test:engine": "node --test tests/engine.test.ts",
		"test:routes": "node --test tests/routes.test.ts",
		"hunt": "node --experimental-strip-types engine/src/cli.ts hunt",
		"hunt:sync": "node --experimental-strip-types engine/src/cli.ts sync",
		"hunt:sync:dry": "node --experimental-strip-types engine/src/cli.ts sync --dry-run",
		"hunt:verify": "node --experimental-strip-types engine/src/cli.ts verify",
		"catalogue": "node scripts/catalogue.mjs",
		"catalogue:fetch": "node scripts/catalogue.mjs fetch --out /tmp/asset-hunter-catalogue.json",
		"check:specimens": "node scripts/check-specimens.mjs",
		"check:visual": "node scripts/visual-qa.mjs",
		"verify": "npm run typecheck && npm run seed:check && npm run seed:validate && npm run check:specimens && npm run check:plates && npm run test",
		"verify:full": "npm run verify && npm run smoke && npm run check:admin-edit && npm run check:visual",
		"skills:sync": "node scripts/sync-emdash-skills.mjs",
		"check:plates": "node scripts/check-plates.mjs",
		"check:admin-edit": "node scripts/admin-edit-check.mjs",
		"generate:og": "node scripts/generate-og.mjs",
		"capture:reference": "node scripts/capture-reference.mjs",
		"check:perf": "node scripts/measure-perf.mjs",
		"check:perf:write": "node scripts/measure-perf.mjs --write"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.3",
		"@astrojs/react": "7.0.0",
		"@emdash-cms/cloudflare": "1.0.1",
		"astro": "7.3.5",
		"effect": "4.0.0",
		"emdash": "1.0.1",
		"oxc-transform-react": "^0.145.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@cloudflare/workers-types": "^5.20261002.1",
		"playwright": "^1.63.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.146.0"
	}
}
