---
/**
 * Search across the catalogue.
 *
 * Uses EmDash's full-text search rather than filtering in the browser, so the
 * result is the same for a visitor with JavaScript, a crawler and a shareable
 * URL. A blank query is a real state with a real answer (suggest starting
 * points), not an error.
 */
import { search } from "emdash";
import Base from "../layouts/Base.astro";
import PossibilityTile from "../components/PossibilityTile.astro";
import ProvenanceMarkers from "../components/ProvenanceMarkers.astro";
import FacetTags from "../components/FacetTags.astro";
import {
	loadCollections,
	loadPossibilities,
	mediaSrc,
	type Possibility,
	EAGER_TILES,
} from "../lib/catalogue";
import { SEARCH_PLACEHOLDER, verticalLabel } from "../lib/vocabulary";
import { Effect } from "effect";
import { runApp } from "../lib/effect/root";
import { excerpt, safeSnippet, searchSuggestions } from "../lib/search-text";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const all = query.length > 0 ? await search(query, { limit: 60 }) : { items: [] };

const { possibilities } = await runApp(loadPossibilities(), { signal: Astro.request.signal });
const bySlug = new Map(possibilities.map((p) => [p.slug, p]));

/**
 * Terms this page offers that are guaranteed to return something.
 *
 * Derived from the catalogue rather than written here, because the hand-written
 * version had already rotted: it suggested "show confidence honestly", which returns
 * no match, on the page whose entire job is helping a reader find a thing.
 */
const suggestions = searchSuggestions(
	possibilities.map((p) => ({ verticalLabel: verticalLabel(p.vertical) })),
);

// Only possibilities and collections are surfaced as results; examples and
// pages are reachable through their parent rather than as separate hits.
const rawHits = all.items.filter(
	(item) => item.collection === "possibilities" || item.collection === "collections",
);

/**
 * EmDash's `snippet` is the matched title, which repeats what the row already
 * shows. What a search result needs to answer is *why* this matched, so the
 * line under the title is the entry's own summary with the query terms marked.
 *
 * Both the marking and the windowing live in `../lib/search-text.ts` (#63), pure
 * and tested: a window that opens mid-word and a meta line that says
 * "Motion / Video  Motion" both read as a rendering fault rather than as a
 * design choice.
 */

/** Query words worth matching: two letters match everything, so they are dropped. */
const queryTerms = query
	.toLowerCase()
	.split(/[^\p{L}\p{N}]+/u)
	.filter((t) => t.length > 2);

/** A window of the summary around the first match, so the reason stays visible. */
const reasonFor = (text: string | null | undefined) => excerpt(text, { terms: queryTerms });

/**
 * EmDash's index knows about every published entry. `loadPossibilities` honours
 * `visibility`, so a withdrawn possibility is *not* in `bySlug` — and without
 * this filter its search hit would fall through to the collection branch and
 * render as a broken row linking to `/collections/<possibility-slug>`, which
 * 404s. A search result for something the catalogue will not show is worse than
 * no result: it implies the thing is findable.
 */
const hits = rawHits
	.filter((item) => item.collection !== "possibilities" || bySlug.has(item.slug ?? ""))
	.map((item) => ({
		item,
		possibility: item.collection === "possibilities" ? bySlug.get(item.slug ?? "") : undefined,
	}));

// Collections are only loaded when a collection actually matched: each one
// costs a reference-resolution request, and most searches hit none.
const collectionHits = hits.filter((h) => !h.possibility).length;
const collectionBySlug = collectionHits
	? new Map(
			(await runApp(loadCollections(), { signal: Astro.request.signal })).collections.map((c) => [
				c.slug,
				c,
			]),
		)
	: new Map<
			string,
			{ title: string; tagline?: string | null; summary?: string | null; members: unknown[] }
		>();

const pages = all.items.filter((i) => i.collection === "pages");
// Counted separately so the summary line cannot overstate what is listed.
const possibilityHits = hits.filter((h) => h.possibility).length;
const verticalsInResults = new Map<string, number>();
for (const h of hits) {
	const v = h.possibility?.vertical;
	if (v) verticalsInResults.set(v, (verticalsInResults.get(v) ?? 0) + 1);
}
const verticalFacets = [...verticalsInResults.entries()].sort((a, b) => b[1] - a[1]);
/**
 * How many verticals the catalogue actually covers.
 *
 * From the loaded possibilities, so the empty state's sentence cannot go stale.
 * A possibility with no vertical is not one a reader can browse, so it is not
 * counted; the `""` stands in for it only so it can be excluded below.
 */
const verticalCount = new Set(
	possibilities.map((p) => p.vertical).filter((v): v is string => Boolean(v)),
).size;

/**
 * What the results line says, and — just as important — what it does not say.
 *
 * Each kind is counted separately and joined with a middle dot, so a mismatch in
 * one cannot cancel out the other (`DESIGN.md` §9.1). The separator used to be
 * appended unconditionally, which meant the zero-result page — the one state
 * where nothing is found — rendered its `role="status"` line as
 *
 *     · for zzqqxxwwnothing
 *
 * A status line that opens with a separator reads as a rendering fault, and it
 * only happened on the emptiest state, which is the state nobody looks at twice.
 * With nothing found the line is just "for *query*", and it is still a status
 * region, so a screen reader is still told the answer.
 */
const parts = [
	possibilityHits > 0 &&
		`${possibilityHits} ${possibilityHits === 1 ? "possibility" : "possibilities"}`,
	collectionHits > 0 &&
		`${collectionHits} ${collectionHits === 1 ? "collection" : "collections"}`,
	pages.length > 0 && `${pages.length} ${pages.length === 1 ? "page" : "pages"}`,
].filter(Boolean);
const counted = parts.length > 0 ? `${parts.join(" · ")} · ` : "";
---

<Base
	title={query ? `Search: ${query}` : "Search"}
	description={
		query
			? `Search results for “${query}” across the Asset Hunter catalogue.`
			: "Search the Asset Hunter catalogue for distinct creative and technical possibilities."
	}
	path={query ? `/search?q=${encodeURIComponent(query)}` : "/search"}
	noindex
>
	<header class="head shell">
		<p class="tag tag--ember">Search</p>
		<h1 class="display head__title">{query ? `“${query}”` : "Find a possibility"}</h1>

		{/*
		 * `q-page`, not `q`.
		 *
		 * The masthead carries a search field with `id="q"` on every page, and the
		 * page's own field used the same id: two elements with one id, a
		 * `<label for="q">` that labelled the masthead's input rather than this
		 * one, and `getElementById("q")` — the `/` shortcut in `Base.astro` —
		 * resolving to the masthead's field even here, where the reader is already
		 * looking at the one they want.
		 */}
		<form class="finder" action="/search" method="get" role="search">
			<label class="visually-hidden" for="q-page">Search possibilities</label>
			<input
				id="q-page"
				type="search"
				name="q"
				value={query}
				placeholder={SEARCH_PLACEHOLDER}
				autocomplete="off"
				spellcheck="false"
				autofocus={!query}
			/>
			<button type="submit">Search</button>
		</form>

		{
			query && (
				<p class="count" role="status">
					{counted}
					for <strong>{query}</strong>
				</p>
			)
		}
	</header>

	<div class="results shell">
		{
			!query && (
				<div class="blank">
					<p class="lede">
						Full-text search over every title, summary and technique note in the catalogue.
						{suggestions.length > 0 && (
							<>
								{" "}
								Try a word the catalogue actually uses:
								<ul class="words">
									{suggestions.map((term) => (
										<li>
											<a href={`/search?q=${encodeURIComponent(term)}`}>{term}</a>
										</li>
									))}
								</ul>
							</>
						)}
					</p>
					<h2 class="tag tag-rule">Browse instead</h2>
					<div class="suggest">
						{possibilities.slice(0, 8).map((p: Possibility, i) => (
							<PossibilityTile possibility={p} eager={i < EAGER_TILES} />
						))}
					</div>
				</div>
			)
		}

		{
			query && hits.length === 0 && pages.length === 0 && (
				<div class="none">
					<h2 class="display none__title">No match for “{query}”</h2>
					<p class="lede">
						Nothing in the catalogue matches that. The catalogue covers {verticalCount}{" "}
						{verticalCount === 1 ? "vertical" : "verticals"} and is deliberately partial, so
						the absence of a result is more likely a gap than an error.
					</p>
					{/*
					 * Every line has to be true of this search, and the previous set was
					 * not. It said "full-text search wants keywords, not sentences" directly
					 * underneath an empty state that suggested three sentences, and told
					 * readers to "search for the problem rather than the solution" on a
					 * catalogue whose entries are filed by technique. A page that argues both
					 * sides in one scroll is worse than a page that admits what it does.
					 */}
					<ul class="tries">
						<li>Try one or two words rather than a whole sentence.</li>
						{suggestions.length > 0 && (
							<li>
								Use a word the catalogue uses:
								<ul class="words">
									{suggestions.map((term) => (
										<li>
											<a href={`/search?q=${encodeURIComponent(term)}`}>{term}</a>
										</li>
									))}
								</ul>
							</li>
						)}
						<li>
							Browse <a href="/verticals">by vertical</a> instead of guessing the vocabulary.
						</li>
					</ul>
					<div class="none__links">
						{/*
						 * Ghost, both of them (#71).
						 *
						 * `DESIGN.md` §2 allows one accent per viewport, and this
						 * state had two solid `--ember` blocks 570px apart: the finder
						 * form's own `Search` submit, and this link. The decision, made
						 * once and written into §2 so the next empty state does not
						 * re-open it: **a form's submit is the accent; a state's own
						 * way out is a link.** You came here to search again, so the
						 * search is the action; browsing is a different page with its
						 * own accent. That is the same split `/board`'s empty state
						 * already makes, where the way in is solid and the way past it
						 * is not.
						 */}
						<a class="button button--ghost" href="/verticals">
							Browse verticals
						</a>
						<a class="button button--ghost" href="/">
							Open the wall
						</a>
					</div>
				</div>
			)
		}

		{
			hits.length > 0 && (
				<>
					{verticalFacets.length > 1 && (
						<nav class="facets" aria-label="Filter results by vertical">
							<ul>
								{verticalFacets.map(([slug, n]) => (
									<li>
										<a href={`/?vertical=${slug}`} class="chip">
											<span>{verticalLabel(slug)}</span>
											<span class="chip__n">{n}</span>
										</a>
									</li>
								))}
							</ul>
						</nav>
					)}

					<h2 class="visually-hidden">Matching possibilities</h2>
					{/*
						Results are rows, not tiles. The wall is the visual surface;
						a search for a known term is a comparison task, and four
						plates at 300px each with the title repeated underneath is
						neither scannable nor honest about how many things matched.
					*/}
					<ol class="found">
						{
							hits.map(({ item, possibility }, index) => {
								const collection = possibility
									? undefined
									: collectionBySlug.get(item.slug ?? "");
								return (
									<li class="found__row">
										<a
											class="found__link"
											href={
												possibility
													? `/possibilities/${possibility.slug}`
													: `/collections/${item.slug}`
											}
										>
											<span class="found__thumb">
												{possibility ? (
													<img
														src={mediaSrc(possibility)}
														alt=""
														width="800"
														height="1000"
														/* The first rows are the answer to the question that
														   brought someone here, so they do not load last. */
														loading={index < 4 ? "eager" : "lazy"}
														decoding="async"
													/>
												) : (
													<span class="found__glyph" aria-hidden="true">
														{collection?.members.length ?? 0}
														<span class="visually-hidden">
															possibilities in this collection
														</span>
													</span>
												)}
											</span>
											<span class="found__body">
												<span class="found__title">
													{possibility?.title ?? collection?.title ?? item.title}
												</span>
												<span class="found__sub">
													{
														(possibility?.tagline ?? collection?.tagline ?? null) || undefined
													}
												</span>
												<span class="found__meta">
													{/*
													 * `FacetTags`, so this row and the wall tile derive
													 * the vertical and media-kind labels from one rule (#67).
													 * This markup was a third copy of it, which is how the
													 * same `Motion / Video  Motion` line was fixed here in
													 * #63 and was still on the wall tile two commits later.
													 */}
													<FacetTags
														vertical={possibility?.vertical}
														mediaKind={possibility?.mediaKind}
														class="found__facets"
													/>
													<ProvenanceMarkers
														rights={possibility?.rightsStatus}
														origin={possibility?.representativeOrigin}
														size="sm"
													/>
												</span>
											</span>
										</a>
										{/*
										 * The reason line is a *sibling* of the link, not inside it (#72).
										 *
										 * It was measured at 36–55% of every row — the reason line and the
										 * padding under it were simply not a target, while the title above them
										 * was. The reason line is the part of the row that answers the question
										 * that brought someone here, so it is the worst possible thing to leave
										 * dead.
										 *
										 * It stays outside the link so the link's accessible name is the title
										 * and not a 190-character excerpt; `.found__link::after` covers the whole
										 * row instead, so the row is one target and one keyboard stop either way.
										 */}
										{reasonFor(possibility?.summary ?? collection?.summary) && (
										<p
											class="found__snippet"
											// Built here from escaped text: `markTerms` escapes the
											// source and only wraps whole matched groups, so no
											// query text can reach the page as markup.
											set:html={reasonFor(
												possibility?.summary ?? collection?.summary,
											)}
											/>
										)}
									</li>
								);
							})
						}
					</ol>
				</>
			)
		}

		{
			pages.length > 0 && (
				<section class="pages-found">
					<h2 class="tag tag-rule">Documentation</h2>
					<ul>
						{pages.map((p) => (
							<li>
								<a href={`/pages/${p.slug}`}>
									<span class="pages-found__title">{p.title}</span>
									{p.snippet && (
										<span class="pages-found__snippet" set:html={safeSnippet(p.snippet)} />
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</Base>

<style>
	.head {
		display: grid;
		gap: var(--sp-4);
		justify-items: start;
		padding-block: var(--sp-7) var(--sp-5);
	}

	.head__title {
		font-size: var(--step-4);
		max-width: 26ch;
	}

	.finder {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		width: 100%;
		max-width: 40rem;
	}

	/*
	 * `1 1 22rem`, not `1 1 20rem`.
	 *
	 * The hint is the field's own explanation of itself. Measured in the browser at
	 * every width in the matrix, and asserted by `tests/placeholder.test.ts` so this
	 * stays a number rather than an opinion:
	 *
	 *     360px   need 316px   avail 293px    over by 23px
	 *     390px   need 317px   avail 321px    fits
	 *
	 * So 20rem was *almost* enough and the failure is at 360 — the width where it is
	 * worst, and the one the design authority cares most about.
	 *
	 * It was invisible for a second reason: `flex-wrap: wrap` lets the field shrink
	 * *below* its basis when the button shares the line, so the row still fit and
	 * the placeholder was clipped mid-word inside it. Wrapping only decides whether
	 * the pair shares a line; it does not stop the field being squeezed on that
	 * line. So the basis has to clear the measured need with room to spare, and
	 * `min-width: 0` is deliberately *not* set — letting the field shrink is the
	 * behaviour being fixed.
	 *
	 * And at 360 it was still 23px short, because the field's own horizontal padding
	 * lives inside the box: 327px of row, 32px of padding, 293px of text space, and
	 * the sentence needs 316. No flex basis fixes that, because at this width the
	 * *container* is the constraint. So the padding gives ground below 30rem only,
	 * where the sentence then has 317px against a 316px need — and
	 * `tests/placeholder.test.ts` measures that rather than trusting the arithmetic.
	 *
	 * This stays a layout answer rather than a copy one. The words are `DESIGN.md`
	 * §9.1's, and §3 puts 10–13px mono as the floor for this voice, so shrinking the
	 * type to fit would edit the design authority from the wrong end.
	 */
	.finder input {
		flex: 1 1 22rem;
		min-height: 3rem;
		padding: 0.7rem 1rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--step-0);
	}

	.finder input::placeholder {
		color: var(--ink-4);
	}

	/*
	 * Reduced horizontal padding, at 360 only.
	 *
	 * At the narrowest width in the matrix the row is 327px, and 32px of that is
	 * the field's own padding. The placeholder needs the rest of it and more, so
	 * this is where the two halves of the sentence used to meet mid-word.
	 *
	 * Scoped below 30rem because everywhere else the field has room and the padding
	 * is not the problem. The touch target does not shrink with its padding — only
	 * its interior does — so this costs reachability nothing.
	 */
	@media (width <= 30rem) {
		.finder input {
			padding-inline: 0.75rem;
		}
	}

	.finder input:focus {
		border-color: var(--ember-line);
		background: var(--surface-2);
	}

	.finder button,
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.7rem 1.4rem;
		background: var(--ember);
		color: var(--canvas);
		border: 1px solid var(--ember);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		font-weight: 600;
		cursor: pointer;
		transition: background var(--dur-fast) var(--ease-out);
	}

	.finder button:hover,
	.button:hover {
		background: color-mix(in srgb, var(--ember) 86%, white);
	}

	.button--ghost {
		background: transparent;
		color: var(--ink-2);
		border-color: var(--line-loud);
	}

	.button--ghost:hover {
		background: var(--surface-2);
		color: var(--ink);
	}

	.count {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--ink-3);
	}

	.count strong {
		color: var(--ink);
	}

	.results {
		padding-bottom: var(--sp-7);
	}

	/* --- Result rows --- */

	.found {
		list-style: none;
		padding: 0;
		display: grid;
		/* One row per hit, ranked. A grid of plates would make four results look
		   like the whole answer, which is the card-soup pattern. */
		gap: 0;
		border-top: 1px solid var(--line);
	}

	.found__row {
		border-bottom: 1px solid var(--line);
		/* The stretched link below needs a containing block, and the row is the
		   element whose whole area it covers. */
		position: relative;
	}

	/*
	 * One convention, stated once (#72).
	 *
	 * The reason line is a sibling of the link rather than inside it, so the
	 * pseudo-element below is what makes the whole row a target: 36–55% of each
	 * row used to be dead space under a live title. The `Documentation` rows
	 * further down put their excerpt *inside* the link, which achieves the same
	 * thing by a different mechanism — one page, one pattern, two answers for a
	 * reader trying to work out what is clickable.
	 *
	 * The link keeps its own text content, so the accessible name is the title
	 * and its markers rather than a 190-character excerpt, and the row is still
	 * one Tab stop.
	 */
	.found__link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.found__link:focus-visible::after {
		outline: 2px solid var(--ember-line);
		outline-offset: -2px;
	}

	/*
	 * `clamp(5.5rem, 12vw, 9rem)`, not a fixed `4.5rem` (#73).
	 *
	 * Measured, the row is 1,206px wide at 1280 and the thumbnail is 72px — 6% of
	 * the row, and the same 72px at 1920. A fixed column is the absence of a size
	 * decision rather than one, and §6a asks for the plate to grow with the row.
	 *
	 * This is an *identifier*, so §6's 0.7 annotation floor does not apply: a reader
	 * is asking which row is the one they want, and the title carries the meaning.
	 * `12vw` takes it from 88px on a 360px phone to the 144px cap at 1200px and up.
	 *
	 * The snippet's indent is derived from the same number rather than repeated as
	 * a literal, so the excerpt cannot drift out of line with the plate again.
	 */	.found__link {
		--row-thumb: clamp(5.5rem, 12vw, 9rem);
		display: grid;
		grid-template-columns: var(--row-thumb) minmax(0, 1fr);
		gap: var(--sp-4);
		align-items: center;
		padding-block: var(--sp-3);
	}

	/*
	 * Hover on the *row*, not the link box.
	 *
	 * The background now covers the reason line too, which is the feedback that
	 * tells a reader the excerpt they are pointing at is part of the link.
	 */
	.found__row:hover {
		background: var(--surface);
	}

	.found__link:hover .found__title {
		color: var(--ember);
	}

	.found__thumb {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.found__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Collections have no single plate, so the count is the mark — a number the
	   visitor can compare, not a decorative icon. */
	.found__glyph {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-1);
		color: var(--ink-3);
		font-variant-numeric: tabular-nums;
	}

	.found__body {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}

	.found__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-0);
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.found__link:hover .found__title,
	.found__row:hover .found__title {
		color: var(--ember);
	}

	.found__sub {
		font-size: var(--step--1);
		color: var(--ink-3);
	}

	.found__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.85rem;
		margin-top: 0.2rem;
	}

	/*
	 * One excerpt style for both result lists (#72).
	 *
	 * `.found__snippet` and `.pages-found__snippet` were the same paragraph with
	 * two class names, two sets of numbers and one difference that was not a
	 * difference: the search excerpt sat *outside* its link and the documentation
	 * excerpt inside it, on the same page. They now share a rule so a change to
	 * how a marked term reads cannot land on one list and miss the other.
