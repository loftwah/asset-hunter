---
/**
 * Search across the catalogue.
 *
 * Uses EmDash's full-text search rather than filtering in the browser, so the
 * result is the same for a visitor with JavaScript, a crawler and a shareable
 * URL. A blank query is a real state with a real answer (suggest starting
 * points), not an error.
 */
import { search } from "emdash";
import Base from "../layouts/Base.astro";
import PossibilityTile from "../components/PossibilityTile.astro";
import ProvenanceMarkers from "../components/ProvenanceMarkers.astro";
import {
	loadCollections,
	loadPossibilities,
	mediaSrc,
	type Possibility,
} from "../lib/catalogue";
import { MEDIA_LABEL, verticalLabel } from "../lib/vocabulary";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const all = query.length > 0 ? await search(query, { limit: 60 }) : { items: [] };

const { possibilities } = await loadPossibilities();
const bySlug = new Map(possibilities.map((p) => [p.slug, p]));

// Only possibilities and collections are surfaced as results; examples and
// pages are reachable through their parent rather than as separate hits.
const rawHits = all.items.filter(
	(item) => item.collection === "possibilities" || item.collection === "collections",
);

/**
 * EmDash's `snippet` is the matched title, which repeats what the row already
 * shows. What a search result needs to answer is *why* this matched, so the
 * line under the title is the entry's own summary with the query terms marked.
 * The text is escaped before any markup is added.
 */
const escapeHtml = (value: string) =>
	value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/** Query words worth matching: two letters match everything, so they are dropped. */
const queryTerms = query
	.toLowerCase()
	.split(/[^\p{L}\p{N}]+/u)
	.filter((t) => t.length > 2);

const markTerms = (value: string) => {
	if (!queryTerms.length) return escapeHtml(value);
	const escaped = escapeHtml(value);
	// Case-insensitive, bounded alternation, longest-first so "seams" is not
	// split into "seam" + a stray "s" when both are in the query.
	const pattern = [...new Set(queryTerms)]
		.sort((a, b) => b.length - a.length)
		.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
		.join("|");
	const re = new RegExp(`(${pattern})`, "gi");
	// Split/restore rather than a replacer, so the query text itself can never
	// inject markup: only whole matched groups are wrapped.
	return escaped
		.split(re)
		.map((part, i) => (i % 2 === 1 ? `<mark>${part}</mark>` : part))
		.join("");
};

/** A window of the summary around the first match, so the reason stays visible. */
const reasonFor = (text: string | null | undefined) => {
	if (!text) return null;
	const lower = text.toLowerCase();
	let at = -1;
	for (const term of queryTerms) {
		at = lower.indexOf(term);
		if (at !== -1) break;
	}
	const WINDOW = 190;
	if (at === -1) {
		const cut = text.length > WINDOW ? `${text.slice(0, WINDOW).trimEnd()}…` : text;
		return markTerms(cut);
	}
	const start = Math.max(0, at - Math.floor(WINDOW / 3));
	const end = Math.min(text.length, start + WINDOW);
	return `${start > 0 ? "…" : ""}${markTerms(text.slice(start, end).trim())}${end < text.length ? "…" : ""}`;
};

const hits = rawHits.map((item) => ({
	item,
	possibility: item.collection === "possibilities" ? bySlug.get(item.slug ?? "") : undefined,
}));

// Collections are only loaded when a collection actually matched: each one
// costs a reference-resolution request, and most searches hit none.
const collectionHits = hits.filter((h) => !h.possibility).length;
const collectionBySlug = collectionHits
	? new Map((await loadCollections()).collections.map((c) => [c.slug, c]))
	: new Map<
			string,
			{ title: string; tagline?: string | null; summary?: string | null; members: unknown[] }
		>();

const pages = all.items.filter((i) => i.collection === "pages");
// Counted separately so the summary line cannot overstate what is listed.
const possibilityHits = hits.filter((h) => h.possibility).length;
const verticalsInResults = new Map<string, number>();
for (const h of hits) {
	const v = h.possibility?.vertical;
	if (v) verticalsInResults.set(v, (verticalsInResults.get(v) ?? 0) + 1);
}
const verticalFacets = [...verticalsInResults.entries()].sort((a, b) => b[1] - a[1]);
---

<Base
	title={query ? `Search: ${query}` : "Search"}
	description={
		query
			? `Search results for “${query}” across the Asset Hunter catalogue.`
			: "Search the Asset Hunter catalogue for distinct creative and technical possibilities."
	}
	path={query ? `/search?q=${encodeURIComponent(query)}` : "/search"}
	noindex
>
	<header class="head shell">
		<p class="tag tag--ember">Search</p>
		<h1 class="display head__title">{query ? `“${query}”` : "Find a possibility"}</h1>

		<form class="finder" action="/search" method="get" role="search">
			<label class="visually-hidden" for="q">Search possibilities</label>
			<input
				id="q"
				type="search"
				name="q"
				value={query}
				placeholder="Technique, treatment, problem, tool"
				autocomplete="off"
				spellcheck="false"
				autofocus={!query}
			/>
			<button type="submit">Search</button>
		</form>

		{
			query && (
				<p class="count" role="status">
					{[
						possibilityHits > 0 &&
							`${possibilityHits} ${possibilityHits === 1 ? "possibility" : "possibilities"}`,
						collectionHits > 0 &&
							`${collectionHits} ${collectionHits === 1 ? "collection" : "collections"}`,
						pages.length > 0 &&
							`${pages.length} ${pages.length === 1 ? "page" : "pages"}`,
					]
						.filter(Boolean)
						.join(" · ")}
					{" · "}
					for <strong>{query}</strong>
				</p>
			)
		}
	</header>

	<div class="results shell">
		{
			!query && (
				<div class="blank">
					<p class="lede">
						Search by what you are trying to do rather than what you think it is called —
						"readability at small size", "loop without a seam", "show confidence honestly".
					</p>
					<h2 class="tag tag-rule">Browse instead</h2>
					<div class="suggest">
						{possibilities.slice(0, 8).map((p: Possibility) => (
							<PossibilityTile possibility={p} />
						))}
					</div>
				</div>
			)
		}

		{
			query && hits.length === 0 && pages.length === 0 && (
				<div class="none">
					<h2 class="display none__title">No match for “{query}”</h2>
					<p class="lede">
						Nothing in the catalogue matches that. The catalogue covers 13 verticals and is
						deliberately partial, so the absence of a result is more likely a gap than an
						error.
					</p>
					<ul class="tries">
						<li>Try a shorter phrase — full-text search wants keywords, not sentences.</li>
						<li>Search for the problem rather than the solution.</li>
						<li>Browse a vertical instead of guessing the vocabulary.</li>
					</ul>
					<div class="none__links">
						<a class="button" href="/verticals">
							Browse verticals
						</a>
						<a class="button button--ghost" href="/">
							Open the wall
						</a>
					</div>
				</div>
			)
		}

		{
			hits.length > 0 && (
				<>
					{verticalFacets.length > 1 && (
						<nav class="facets" aria-label="Filter results by vertical">
							<ul>
								{verticalFacets.map(([slug, n]) => (
									<li>
										<a href={`/?vertical=${slug}`} class="chip">
											<span>{verticalLabel(slug)}</span>
											<span class="chip__n">{n}</span>
										</a>
									</li>
								))}
							</ul>
						</nav>
					)}

					<h2 class="visually-hidden">Matching possibilities</h2>
					{/*
						Results are rows, not tiles. The wall is the visual surface;
						a search for a known term is a comparison task, and four
						plates at 300px each with the title repeated underneath is
						neither scannable nor honest about how many things matched.
					*/}
					<ol class="found">
						{
							hits.map(({ item, possibility }) => {
								const collection = possibility
									? undefined
									: collectionBySlug.get(item.slug ?? "");
								return (
									<li class="found__row">
										<a
											class="found__link"
											href={
												possibility
													? `/possibilities/${possibility.slug}`
													: `/collections/${item.slug}`
											}
										>
											<span class="found__thumb">
												{possibility ? (
													<img
														src={mediaSrc(possibility)}
														alt=""
														width="800"
														height="1000"
														loading="lazy"
														decoding="async"
													/>
												) : (
													<span class="found__glyph" aria-hidden="true">
														{collection?.members.length ?? 0}
														<span class="visually-hidden">
															possibilities in this collection
														</span>
													</span>
												)}
											</span>
											<span class="found__body">
												<span class="found__title">
													{possibility?.title ?? collection?.title ?? item.title}
												</span>
												<span class="found__sub">
													{
														(possibility?.tagline ?? collection?.tagline ?? null) || undefined
													}
												</span>
												<span class="found__meta">
													{possibility?.vertical && (
														<span class="tag">{verticalLabel(possibility.vertical)}</span>
													)}
													{possibility?.mediaKind && (
														<span class="tag">
															{MEDIA_LABEL[possibility.mediaKind] ?? possibility.mediaKind}
														</span>
													)}
													<ProvenanceMarkers
														rights={possibility?.rightsStatus}
														origin={possibility?.representativeOrigin}
														size="sm"
													/>
												</span>
											</span>
										</a>
										{reasonFor(possibility?.summary ?? collection?.summary) && (
											<p
												class="found__snippet"
												// Built here from escaped text: `markTerms` escapes the
												// source and only wraps whole matched groups, so no
												// query text can reach the page as markup.
												set:html={reasonFor(
													possibility?.summary ?? collection?.summary,
												)}
											/>
										)}
									</li>
								);
							})
						}
					</ol>
				</>
			)
		}

		{
			pages.length > 0 && (
				<section class="pages-found">
					<h2 class="tag tag-rule">Documentation</h2>
					<ul>
						{pages.map((p) => (
							<li>
								<a href={`/pages/${p.slug}`}>
									<span class="pages-found__title">{p.title}</span>
									{p.snippet && <span class="pages-found__snippet" set:html={p.snippet} />}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</Base>

<style>
	.head {
		display: grid;
		gap: var(--sp-4);
		justify-items: start;
		padding-block: var(--sp-7) var(--sp-5);
	}

	.head__title {
		font-size: var(--step-4);
		max-width: 26ch;
	}

	.finder {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		width: 100%;
		max-width: 40rem;
	}

	.finder input {
		flex: 1 1 16rem;
		min-height: 3rem;
		padding: 0.7rem 1rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--step-0);
	}

	.finder input::placeholder {
		color: var(--ink-4);
	}

	.finder input:focus {
		border-color: var(--ember-line);
		background: var(--surface-2);
	}

	.finder button,
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.7rem 1.4rem;
		background: var(--ember);
		color: var(--canvas);
		border: 1px solid var(--ember);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		font-weight: 600;
		cursor: pointer;
		transition: background var(--dur-fast) var(--ease-out);
	}

	.finder button:hover,
	.button:hover {
		background: color-mix(in srgb, var(--ember) 86%, white);
	}

	.button--ghost {
		background: transparent;
		color: var(--ink-2);
		border-color: var(--line-loud);
	}

	.button--ghost:hover {
		background: var(--surface-2);
		color: var(--ink);
	}

	.count {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--ink-3);
	}

	.count strong {
		color: var(--ink);
	}

	.results {
		padding-bottom: var(--sp-7);
	}

	/* --- Result rows --- */

	.found {
		list-style: none;
		padding: 0;
		display: grid;
		/* One row per hit, ranked. A grid of plates would make four results look
		   like the whole answer, which is the card-soup pattern. */
		gap: 0;
		border-top: 1px solid var(--line);
	}

	.found__row {
		border-bottom: 1px solid var(--line);
	}

	.found__link {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: var(--sp-4);
		align-items: center;
		padding-block: var(--sp-3);
		transition: background var(--dur-fast) var(--ease-out);
	}

	.found__link:hover {
		background: var(--surface);
	}

	.found__thumb {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.found__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Collections have no single plate, so the count is the mark — a number the
	   visitor can compare, not a decorative icon. */
	.found__glyph {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-1);
		color: var(--ink-3);
		font-variant-numeric: tabular-nums;
	}

	.found__body {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}

	.found__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-0);
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.found__link:hover .found__title {
		color: var(--ember);
	}

	.found__sub {
		font-size: var(--step--1);
		color: var(--ink-3);
	}

	.found__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.85rem;
		margin-top: 0.2rem;
	}

	.found__snippet {
		padding: 0 0 var(--sp-3) calc(4.5rem + var(--sp-4));
		font-size: var(--step--1);
		line-height: 1.5;
		color: var(--ink-3);
		max-width: 78ch;
	}

	@media (width <= 560px) {
		.found__link {
			grid-template-columns: 3.25rem minmax(0, 1fr);
			gap: var(--sp-3);
		}

		.found__snippet {
			padding-left: calc(3.25rem + var(--sp-3));
		}
	}

	/* EmDash emits <mark> around matched terms; make the highlight legible on
	   this dark ground rather than leaving browser defaults. */
	.found__snippet :global(mark) {
		background: var(--ember-wash);
		color: var(--ink);
		border-radius: 2px;
		padding: 0 0.15em;
	}

	.facets ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		list-style: none;
		padding: 0;
		margin-bottom: var(--sp-5);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		/* 2.75rem clears the 44px touch minimum with room to spare. */
		min-height: 2.75rem;
		padding: 0.3rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--ink-2);
		transition: color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	.chip:hover {
		color: var(--ink);
		border-color: var(--ember-line);
	}

	.chip__n {
		color: var(--ink-4);
		font-variant-numeric: tabular-nums;
	}

	.blank,
	.none {
		display: grid;
		gap: var(--sp-4);
		justify-items: start;
		max-width: var(--measure);
		padding-block: var(--sp-4);
	}

	.none__title {
		font-size: var(--step-3);
	}

	.tries {
		display: grid;
		gap: var(--sp-2);
		padding-left: 1.1rem;
		color: var(--ink-3);
		font-size: var(--step--1);
	}

	.none__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
		margin-top: var(--sp-2);
	}

	.suggest {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
		gap: var(--sp-5) var(--sp-4);
	}

	.pages-found {
		margin-top: var(--sp-7);
		padding-top: var(--sp-6);
		border-top: 1px solid var(--line);
	}

	.pages-found ul {
		list-style: none;
		padding: 0;
		margin-top: var(--sp-4);
	}

	.pages-found a {
		display: grid;
		gap: var(--sp-2);
		padding: var(--sp-4) 0;
		border-bottom: 1px solid var(--line);
	}

	.pages-found__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-1);
		color: var(--ink);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.pages-found a:hover .pages-found__title {
		color: var(--ember);
	}

	.pages-found__snippet {
		font-size: var(--step--1);
		line-height: 1.5;
		color: var(--ink-3);
	}

	.pages-found__snippet :global(mark) {
		background: var(--ember-wash);
		color: var(--ink);
		border-radius: 2px;
		padding: 0 0.15em;
	}
</style>
