---
/**
 * Drill-in page for a single possibility.
 *
 * Structure follows what someone actually needs when deciding a direction:
 * what it is, how it is done, what to watch out for, how to prompt it, what
 * examples exist, and — never buried — what the rights situation is.
 */
import Base from "../../layouts/Base.astro";
import PossibilityTile from "../../components/PossibilityTile.astro";
import ProvenanceMarkers from "../../components/ProvenanceMarkers.astro";
import ExampleUse from "../../components/ExampleUse.astro";
import {
	loadExamplesFor,
	loadPossibilities,
	loadPossibility,
	mediaSrc,
} from "../../lib/catalogue";
import { assetUsePaths, summariseUse, summaryLine } from "../../lib/asset-use";
import { Effect } from "effect";
import { runApp } from "../../lib/effect/root";
import {
	MEDIA_LABEL,
	ORIGIN_MEANING,
	RIGHTS_MEANING,
	originLabelFor,
	rightsLabelFor,
	verticalLabel,
} from "../../lib/vocabulary";
import {
	REPORTS,
	REPORT_REASONS,
	SIGNAL_MEANING,
	aggregateRatings,
	ratingSummary,
} from "../../lib/rating";
import {
	actorFrom,
	loadRatings,
	loadReports,
	reportsForSubject,
} from "../../lib/signals";

const { slug } = Astro.params;
const { possibility: p, cacheHint } = await runApp(loadPossibility(slug ?? ""), {
	signal: Astro.request.signal,
});
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

if (!p) {
	return Astro.rewrite("/404");
}

// `Effect.all` rather than `Promise.all`: same shape, in a runtime that can be
// interrupted when the reader navigates away mid-render.
const [{ possibilities }, { examples }] = await runApp(
	Effect.all([loadPossibilities(), loadExamplesFor(p.slug)]),
	{ signal: Astro.request.signal },
);

const src = mediaSrc(p);
const vertical = p.vertical ? verticalLabel(p.vertical) : null;

// Signals (#37). The viewer is EmDash's authenticated user; a rating needs one
// so it can be revised or withdrawn, and a report does not, because refusing a
// "this licence is wrong" note because someone has no account is the worst
// possible answer to it.
const viewer = actorFrom(Astro.locals?.user);
const [ratings, reports] = await runApp(Effect.all([loadRatings(), loadReports()]), {
	signal: Astro.request.signal,
});
const community = aggregateRatings(
	ratings.filter((r) => r.subjectType === "possibility" && r.subjectSlug === p.slug),
	viewer?.id ?? null,
);
const openReports = reportsForSubject(reports, "possibility", p.slug).filter(
	(r) => !r.resolution,
);

// Neighbours come from the same vertical where possible, because "what else
// could I do in this area" is the question a visitor arrived with.
const sameVertical = possibilities.filter((x) => x.vertical === p.vertical && x.slug !== p.slug);
const others = possibilities.filter((x) => x.vertical !== p.vertical && x.slug !== p.slug);
const related = [...sameVertical, ...others].slice(0, 4);

function promptLines(value: string | null | undefined): string[] {
	if (!value) return [];
	return value
		.split(/(?<=\.)\s+/)
		.map((s) => s.trim())
		.filter(Boolean);
}
const scaffold = promptLines(p.promptScaffold);

/*
 * The use states of the examples beneath this possibility (#42), counted here
 * so the drill-in leads with the answer rather than making a reader open
 * something to find out whether anything is reusable. The counts come from the
 * same `examples` the list below renders, so the number and the rows cannot
 * disagree. The labels themselves live in `src/lib/vocabulary.ts`.
 */
const useSummary = summariseUse(examples);
---

<Base
	title={p.title}
	description={p.summary ?? p.tagline ?? "A catalogued possibility on Asset Hunter."}
	path={`/possibilities/${p.slug}`}
	ogImage={src}
>
	<article class="detail">
		<header class="head shell">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Catalogue</a>
				{vertical && <><span aria-hidden="true">/</span><a href={`/verticals#${p.vertical}`}>{vertical}</a></>}
				<span aria-hidden="true">/</span>
				<span class="crumbs__here">{p.title}</span>
			</nav>

			<h1 class="display head__title">{p.title}</h1>
			{p.tagline && <p class="head__tagline">{p.tagline}</p>}

			<div class="head__marks">
				<ProvenanceMarkers rights={p.rightsStatus} origin={p.representativeOrigin} />
			</div>

			{
				p.summary && (
					<p class="lede head__summary">{p.summary}</p>
				)
			}

			<dl class="facts">
				{
					vertical && (
						<div>
							<dt class="tag">Vertical</dt>
							<dd><a href={`/verticals#${p.vertical}`}>{vertical}</a></dd>
						</div>
					)
				}
				{
					p.mediaKind && (
						<div>
							<dt class="tag">Media</dt>
							<dd>{MEDIA_LABEL[p.mediaKind] ?? p.mediaKind}</dd>
						</div>
					)
				}
				<div>
					<dt class="tag">Examples</dt>
					<dd>{examples.length || (p.exampleCount ?? 0)}</dd>
				</div>
				<div>
					<dt class="tag">Verified sources</dt>
					<dd>{p.distinctSources ?? 0}</dd>
				</div>
			</dl>
		</header>

		<div class="body shell">
			<figure class="plate">
				<img
					src={src}
					alt={p.tagline ? `${p.title} — ${p.tagline}` : p.title}
					width="800"
					height="1000"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
				<figcaption class="tag">
					{
						p.representativeOrigin
							? `${originLabelFor(p.representativeOrigin)} specimen`
							: "Specimen"
					}
					· reference plate
				</figcaption>
			</figure>

			<div class="prose-col">
				{
					p.technique && (
						<section aria-labelledby="technique">
							<h2 id="technique" class="section__title">Technique</h2>
							<p>{p.technique}</p>
						</section>
					)
				}

				{
					p.buildNotes && (
						<section aria-labelledby="notes">
							<h2 id="notes" class="section__title">Build notes</h2>
							<p>{p.buildNotes}</p>
						</section>
					)
				}

				{
					scaffold.length > 0 && (
						<section aria-labelledby="prompt">
							<h2 id="prompt" class="section__title">Prompt scaffold</h2>
							<p class="section__hint">
								A starting scaffold, not a proven prompt. Change it and compare results.
							</p>
							<blockquote class="scaffold">
								{scaffold.map((line) => (
									<span class="scaffold__line">{line}</span>
								))}
							</blockquote>
						</section>
					)
				}

				{/*
					Three signals, three named places (#37). They are laid out separately
					rather than as one blended score, because a reader's stars, a
					curator's judgement and an inspection result are three different kinds
					of claim, and a blend of them cannot be explained to anyone who asks.
				*/}
				<section aria-labelledby="signals" class="signals">
					<h2 id="signals" class="section__title">Signals</h2>

					<div class="signal">
						<p class="signal__head">
							<span class="tag">Community</span>
							<span class="signal__value">{ratingSummary(community)}</span>
						</p>
						<p class="signal__meaning">{SIGNAL_MEANING.community}</p>
						{community.count > 0 && (
							<ul class="dist" aria-label="Rating distribution">
								{[5, 4, 3, 2, 1].map((star) => {
									const n = community.distribution[star];
									const pct = community.count
										? Math.round((n / community.count) * 100)
										: 0;
									return (
										<li class="dist__row">
											<span class="tag">{star}★</span>
											<span class="dist__bar" aria-hidden="true">
												<span class="dist__fill" style={`width:${pct}%`} />
											</span>
											<span class="dist__n">{n}</span>
										</li>
									);
								})}
							</ul>
						)}
						<form class="rate" method="post" action="/api/signal">
							<input type="hidden" name="intent" value="rate" />
							<input type="hidden" name="subject_type" value="possibility" />
							<input type="hidden" name="subject_slug" value={p.slug} />
							<input type="hidden" name="back" value={`/possibilities/${p.slug}`} />
							<fieldset>
								<legend class="tag">Rate it</legend>
								{[1, 2, 3, 4, 5].map((star) => (
									<label class="rate__star">
										<input
											type="radio"
											name="stars"
											value={star}
											checked={community.mine === star}
											required={!viewer}
										/>
										<span aria-hidden="true">★</span>
										<span class="visually-hidden">{star} of 5</span>
									</label>
								))}
								<button type="submit" disabled={!viewer}>
									{community.mine ? "Change" : "Rate"}
								</button>
							</fieldset>
						</form>
						{!viewer && (
							<p class="signal__note">
								A rating you cannot revise or withdraw is not an opinion, it is a vote, so
								signing in is required.
							</p>
						)}
					</div>

					<div class="signal">
						<p class="signal__head">
							<span class="tag">Editorial</span>
							<span class="signal__value">
								{p.featured ? "Featured by a curator" : "Not featured"}
							</span>
						</p>
						<p class="signal__meaning">{SIGNAL_MEANING.editorial}</p>
						<p class="signal__note">
							A person's decision, made in the admin. It is not popularity, and it does not
							move when ratings move.
						</p>
					</div>

					<div class="signal">
						<p class="signal__head">
							<span class="tag">Machine</span>
							<span class="signal__value">
								{p.novelty === null && p.coverage === null
									? "Not measured"
									: `novelty ${p.novelty ?? "—"} · coverage ${p.coverage ?? "—"}`}
							</span>
						</p>
						<p class="signal__meaning">{SIGNAL_MEANING.machine}</p>
						<p class="signal__note">
							{(p.distinctSources ?? 0) === 0
								? "No source has had its licence read yet, so there is nothing to measure against."
								: `${p.distinctSources} source licence(s) read at a specific commit.`}
						</p>
					</div>
				</section>

				<section aria-labelledby="report" class="report">
					<h2 id="report" class="section__title">Report a problem</h2>
					<p class="report__why">
						A report is not a low rating. Use it when something here is wrong rather than
						bad, and a licence concern is read before anything else.
					</p>
					<form class="report__form" method="post" action="/api/signal">
						{/* The disabled state lives on the fieldset, not on the form: a
						    disabled form cannot be submitted at all, which turns "you need
						    to sign in" into a button that silently does nothing. */}
						<fieldset disabled={!viewer}>
							<legend class="visually-hidden">File a report about this entry</legend>
							<input type="hidden" name="intent" value="report" />
							<input type="hidden" name="subject_type" value="possibility" />
							<input type="hidden" name="subject_slug" value={p.slug} />
							<input type="hidden" name="back" value={`/possibilities/${p.slug}`} />
							<label class="report__label tag" for="reason">What is wrong</label>
							<select id="reason" name="reason">
								{REPORT_REASONS.map((reason) => (
									<option value={reason}>{REPORTS[reason].label}</option>
								))}
							</select>
							<p class="report__reason-meaning">
								{/* About the licence reason specifically, not about whichever option is
								    selected: without JavaScript there is nothing to switch this, and
								    a description that does not match the open option is worse than
								    none. */}
								A licence concern is read before anything else here. If the status no
								longer matches what the source says, that is a correction rather than a
								preference.
							</p>
							<label class="report__label tag" for="detail">Details (optional)</label>
							<textarea
								id="detail"
								name="detail"
								rows="3"
								maxlength="2000"
								placeholder="What you saw, and where. One line is enough to act on."
							/>
							<button type="submit">File the report</button>
						</fieldset>
					</form>
					{!viewer && (
						<p class="signal__note">
							Filing needs a sign-in, because a report nobody can answer is worse than no
							report. With no account at all, the
							<a href="/pages/licensing">licensing page</a> carries the contact route.
						</p>
					)}
					{openReports.length > 0 && (
						<p class="report__open">
							{openReports.length} open report{openReports.length === 1 ? "" : "s"} on this
							entry.
						</p>
					)}
				</section>

				<section aria-labelledby="rights">
					<h2 id="rights" class="section__title">Rights</h2>
					{
						p.rightsStatus && (
							<p class="rights__status" style={`--c: var(--rights-${p.rightsStatus})`}>
								<span class="rights__dot" aria-hidden="true" />
								<strong>{rightsLabelFor(p.rightsStatus)}</strong>
								<span class="rights__meaning">
									{RIGHTS_MEANING[p.rightsStatus as keyof typeof RIGHTS_MEANING]}
								</span>
							</p>
						)
					}
					{p.rightsNote && <p class="rights__note">{p.rightsNote}</p>}
					<p class="rights__disclaimer">
						Possibility discovery does not grant rights to the source asset. Read the licence
						on the original before you reuse anything.
						<a href="/pages/licensing">How rights are classified</a>.
					</p>
				</section>
			</div>
		</div>

		/*
			Examples and their use states (#42). The list stays media-first and the
			use block sits inside each row, because a reader who has to leave the
			page to find out whether a file is reusable will not find out. The
			counts above come from these same examples.
		*/
		{
			examples.length > 0 && (
				<section class="examples shell" aria-labelledby="examples-title">
					<h2 id="examples-title" class="tag tag-rule">Examples · {examples.length}</h2>
					<p class="examples__summary" data-use-summary={summaryLine(useSummary)}>
						{summaryLine(useSummary)} ·{" "}
						<a class="examples__use-link" href={assetUsePaths.use(p.slug)}>
							What may be used, and what it costs
						</a>
					</p>
					<ul class="examples__list">
						{examples.map((example) => (
							<li class="example">
								<div class="example__media">
									<img
										src={mediaSrc(example, src)}
										alt={example.title}
										width="800"
										height="1000"
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="example__body">
									<h3 class="example__title">{example.title}</h3>
									<ProvenanceMarkers
										rights={example.rightsStatus}
										origin={example.origin}
										size="sm"
									/>
									{example.origin && (
										<p class="example__origin">
											{ORIGIN_MEANING[example.origin as keyof typeof ORIGIN_MEANING]}
										</p>
									)}
									{example.note && <p class="example__note">{example.note}</p>}
								</div>
								{/*
								 * Full width under the media and the label, not squeezed into the
								 * label column: the actions and the credit block need room to be
								 * read rather than scrolled.
								 */}
								<ExampleUse example={example} />
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			related.length > 0 && (
				<section class="related shell" aria-labelledby="related-title">
					<h2 id="related-title" class="tag tag-rule">Related possibilities</h2>
					<div class="related__grid">
						{related.map((r) => (
							<PossibilityTile possibility={r} />
						))}
					</div>
				</section>
			)
		}
	</article>
</Base>

<style>
	.detail {
		display: grid;
	}

	/* --- Header --- */

	.head {
		display: grid;
		gap: var(--sp-4);
		padding-block: var(--sp-5) var(--sp-6);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.1rem 0.5rem;
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-4);
	}

	/* Padding, not type size, carries the tap target: breadcrumb type is
	   intentionally small so the hierarchy stays readable. */
	.crumbs a,
	.crumbs__here {
		display: inline-flex;
		align-items: center;
		min-height: 1.75rem;
		padding-inline: 0.15rem;
	}

	.crumbs a {
		color: var(--ink-3);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.crumbs a:hover {
		color: var(--ink);
	}

	.crumbs__here {
		color: var(--ink-2);
	}

	.head__title {
		font-size: var(--step-4);
		max-width: 24ch;
	}

	.head__tagline {
		font-size: var(--step-1);
		color: var(--ink-2);
		max-width: 54ch;
		text-wrap: pretty;
	}

	.head__marks {
		margin-top: calc(var(--sp-2) * -1);
	}

	.head__summary {
		margin-top: var(--sp-2);
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-4) var(--sp-7);
		margin-top: var(--sp-4);
		padding-top: var(--sp-4);
		border-top: 1px solid var(--line);
	}

	.facts dt {
		margin-bottom: 0.15rem;
	}

	.facts dd {
		display: flex;
		align-items: center;
		min-height: 1.9rem;
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 600;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.facts dd a {
		display: inline-flex;
		align-items: center;
		min-height: 1.9rem;
	}

	.facts a:hover {
		color: var(--ember);
	}

	/* --- Body: plate beside prose --- */

	.body {
		display: grid;
		gap: var(--sp-6);
		padding-block: var(--sp-5) var(--sp-7);
		border-top: 1px solid var(--line);
	}

	.plate {
		display: grid;
		gap: var(--sp-3);
		align-content: start;
	}

	.plate img {
		width: 100%;
		height: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.plate figcaption {
		color: var(--ink-4);
	}

	.prose-col {
		display: grid;
		gap: var(--sp-6);
		align-content: start;
		max-width: var(--measure);
	}

	.prose-col p {
		color: var(--ink-2);
		line-height: 1.62;
		text-wrap: pretty;
	}

	.section__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-2);
		letter-spacing: -0.02em;
		color: var(--ink);
		margin-bottom: var(--sp-3);
	}

	.section__hint {
		font-size: var(--step--1);
		color: var(--ink-4);
		margin-top: calc(var(--sp-2) * -1);
		margin-bottom: var(--sp-3);
	}

	.scaffold {
		display: grid;
		gap: var(--sp-2);
		margin: 0;
		padding: var(--sp-4);
		background: var(--surface);
		border: 1px solid var(--line);
		border-left: 2px solid var(--ember-line);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--ink-2);
	}

	/* --- Signals (#37) ---------------------------------------------------
	   Three blocks, never one blended number. Each is labelled by which kind of
	   claim it is, so a reader is never left thinking a star is a measurement. */

	.signals {
		display: grid;
		gap: var(--sp-4);
		margin-top: var(--sp-2);
	}

	.signal {
		display: grid;
		gap: var(--sp-2);
		padding: var(--sp-4);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.signal__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--sp-2) var(--sp-4);
	}

	.signal__value {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step--1);
		color: var(--ink);
		text-align: right;
	}

	.signal__meaning,
	.signal__note {
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--ink-3);
	}

	/* An inline link inside a sentence is still a target: the padding carries the
	   size, not the type, which is why the rule exists everywhere else too. */
	.signal__note a,
	.report__why a {
		display: inline-block;
		min-height: 1.5rem;
		padding-block: 0.2rem;
		color: var(--ember);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.dist {
		display: grid;
		gap: 0.2rem;
		list-style: none;
		padding: 0;
		margin-block: var(--sp-2);
	}

	.dist__row {
		display: grid;
		grid-template-columns: 2.25rem 1fr 1.5rem;
		align-items: center;
		gap: var(--sp-2);
	}

	.dist__bar {
		height: 3px;
		background: var(--surface-3);
		border-radius: 2px;
		overflow: hidden;
	}

	.dist__fill {
		display: block;
		height: 100%;
		background: var(--ember-dim);
	}

	.dist__n {
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--ink-4);
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.rate fieldset {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--sp-2);
		border: 0;
		padding: 0;
		margin: 0;
	}

	.rate legend {
		padding: 0;
		margin-bottom: var(--sp-2);
	}

	.rate__star {
		position: relative;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink-4);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

