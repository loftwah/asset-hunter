---
/**
 * Drill-in page for a single possibility.
 *
 * Structure follows what someone actually needs when deciding a direction:
 * what it is, how it is done, what to watch out for, how to prompt it, what
 * examples exist, and — never buried — what the rights situation is.
 */
import Base from "../../layouts/Base.astro";
import PossibilityTile from "../../components/PossibilityTile.astro";
import ProvenanceMarkers from "../../components/ProvenanceMarkers.astro";
import ExampleUse from "../../components/ExampleUse.astro";
import OutcomeFlash from "../../components/OutcomeFlash.astro";
import SignalPanel from "../../components/SignalPanel.astro";
import {
	loadExamplesFor,
	loadPossibilities,
	loadPossibility,
	mediaSrc,
} from "../../lib/catalogue";
import { assetUsePaths, summariseUse, summaryLine } from "../../lib/asset-use";
import { Effect } from "effect";
import { runApp } from "../../lib/effect/root";
import {
	MEDIA_LABEL,
	ORIGIN_MEANING,
	RIGHTS_MEANING,
	originLabelFor,
	rightsLabelFor,
	verticalLabel,
} from "../../lib/vocabulary";
// Only `aggregateRatings` is used here: the rendering of the three signals and
// the report form moved to `SignalPanel.astro` so `/lab` can show the same
// states against fixtures, and the panel owns its own vocabulary.
import { aggregateRatings } from "../../lib/rating";
import {
	actorFrom,
	loadRatings,
	loadReports,
	reportsForSubject,
} from "../../lib/signals";

const { slug } = Astro.params;
const { possibility: p, cacheHint } = await runApp(loadPossibility(slug ?? ""), {
	signal: Astro.request.signal,
});
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

if (!p) {
	return Astro.rewrite("/404");
}

// `Effect.all` rather than `Promise.all`: same shape, in a runtime that can be
// interrupted when the reader navigates away mid-render.
const [{ possibilities }, { examples }] = await runApp(
	Effect.all([loadPossibilities(), loadExamplesFor(p.slug)]),
	{ signal: Astro.request.signal },
);

const src = mediaSrc(p);
const vertical = p.vertical ? verticalLabel(p.vertical) : null;

// Signals (#37). The viewer is EmDash's authenticated user; a rating needs one
// so it can be revised or withdrawn, and a report does not, because refusing a
// "this licence is wrong" note because someone has no account is the worst
// possible answer to it.
const viewer = actorFrom(Astro.locals?.user);
const [ratings, reports] = await runApp(Effect.all([loadRatings(), loadReports()]), {
	signal: Astro.request.signal,
});
const community = aggregateRatings(
	ratings.filter((r) => r.subjectType === "possibility" && r.subjectSlug === p.slug),
	viewer?.id ?? null,
);
const openReports = reportsForSubject(reports, "possibility", p.slug).filter(
	(r) => !r.resolution,
);

// Neighbours come from the same vertical where possible, because "what else
// could I do in this area" is the question a visitor arrived with.
const sameVertical = possibilities.filter((x) => x.vertical === p.vertical && x.slug !== p.slug);
const others = possibilities.filter((x) => x.vertical !== p.vertical && x.slug !== p.slug);
const related = [...sameVertical, ...others].slice(0, 4);

function promptLines(value: string | null | undefined): string[] {
	if (!value) return [];
	return value
		.split(/(?<=\.)\s+/)
		.map((s) => s.trim())
		.filter(Boolean);
}
const scaffold = promptLines(p.promptScaffold);

/*
 * The use states of the examples beneath this possibility (#42), counted here
 * so the drill-in leads with the answer rather than making a reader open
 * something to find out whether anything is reusable. The counts come from the
 * same `examples` the list below renders, so the number and the rows cannot
 * disagree. The labels themselves live in `src/lib/vocabulary.ts`.
 */
const useSummary = summariseUse(examples);

/*
 * The answer to a rating or a report (#46).
 *
 * `/api/signal` writes a sentence into `?note=` on every branch — "Rating
 * recorded", "Sign in to rate", "Could not save the rating: …", "Pick what is
 * wrong" — and until now nothing read it. The reader was redirected back to a page
 * that looked exactly as it had before they pressed anything, so a failed rating,
 * a refused report and a successful one were indistinguishable. The endpoint is
 * the only place that knows which happened, and this is where that knowledge
 * finally reaches a person. `problem=1` is what makes it a refusal rather than a
 * confirmation.
 */
const note = Astro.url.searchParams.get("note")?.trim() ?? "";
const outcome = note
	? { message: note, tone: Astro.url.searchParams.has("problem") ? ("problem" as const) : ("ok" as const) }
	: null;
---

<Base
	title={p.title}
	description={p.summary ?? p.tagline ?? "A catalogued possibility on Asset Hunter."}
	path={`/possibilities/${p.slug}`}
	ogImage={src}
>
	<article class="detail">
		{/*
		 * Above the header, not beside the form and not under the header.
		 *
		 * The form POST redirects to a fresh document, so the reader is at the top
		 * of the page again; an answer they have to scroll for is an answer most
		 * will never see. And this page's header is ~600px tall on a desktop — a
		 * flash directly beneath it is already below the fold on arrival, which is
		 * where it was first put and where a screenshot of the top of the page did
		 * not show it. `role="alert"` on the refusal case means it is also spoken
		 * without being found, which is the half that cannot be seen.
		 */}
		{
			outcome && (
				<div class="outcome shell">
					<OutcomeFlash message={outcome.message} tone={outcome.tone} />
				</div>
			)
		}

		<header class="head shell">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Catalogue</a>
				{vertical && <><span aria-hidden="true">/</span><a href={`/verticals#${p.vertical}`}>{vertical}</a></>}
				<span aria-hidden="true">/</span>
				<span class="crumbs__here">{p.title}</span>
			</nav>

			<h1 class="display head__title">{p.title}</h1>
			{p.tagline && <p class="head__tagline">{p.tagline}</p>}

			<div class="head__marks">
				<ProvenanceMarkers rights={p.rightsStatus} origin={p.representativeOrigin} />
			</div>

			{
				p.summary && (
					<p class="lede head__summary">{p.summary}</p>
				)
			}

			<dl class="facts">
				{
					vertical && (
						<div>
							<dt class="tag">Vertical</dt>
							<dd><a href={`/verticals#${p.vertical}`}>{vertical}</a></dd>
						</div>
					)
				}
				{
					p.mediaKind && (
						<div>
							<dt class="tag">Media</dt>
							<dd>{MEDIA_LABEL[p.mediaKind] ?? p.mediaKind}</dd>
						</div>
					)
				}
				<div>
					<dt class="tag">Examples</dt>
					<dd>{examples.length || (p.exampleCount ?? 0)}</dd>
				</div>
				<div>
					<dt class="tag">Verified sources</dt>
					<dd>{p.distinctSources ?? 0}</dd>
				</div>
			</dl>
		</header>

		<div class="body shell">
			<figure class="plate">
				<img
					src={src}
					alt={p.tagline ? `${p.title} — ${p.tagline}` : p.title}
					width="800"
					height="1000"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
				<figcaption class="tag">
					{/*
					 * One expression, because JSX drops the whitespace at the start of
					 * the line: the caption was shipping as "Generated specimen· reference
					 * plate". This is the caption that names the plate as a reference
					 * rather than as the asset, so its separator should not look like a
					 * missing space.
					 */}
					{
						(p.representativeOrigin
							? `${originLabelFor(p.representativeOrigin)} specimen`
							: "Specimen") + " · reference plate"
					}
				</figcaption>
			</figure>

			<div class="prose-col">
				{
					p.technique && (
						<section aria-labelledby="technique">
							<h2 id="technique" class="section__title">Technique</h2>
							<p>{p.technique}</p>
						</section>
					)
				}

				{
					p.buildNotes && (
						<section aria-labelledby="notes">
							<h2 id="notes" class="section__title">Build notes</h2>
							<p>{p.buildNotes}</p>
						</section>
					)
				}

				{
					scaffold.length > 0 && (
						<section aria-labelledby="prompt">
							<h2 id="prompt" class="section__title">Prompt scaffold</h2>
							<p class="section__hint">
								A starting scaffold, not a proven prompt. Change it and compare results.
							</p>
							<blockquote class="scaffold">
								{scaffold.map((line) => (
									<span class="scaffold__line">{line}</span>
								))}
							</blockquote>
						</section>
					)
				}

				{/*
					Three signals, three named places (#37). They are laid out separately
					rather than as one blended score, because a reader's stars, a
					curator's judgement and an inspection result are three different kinds
					of claim, and a blend of them cannot be explained to anyone who asks.

					The markup lives in `SignalPanel.astro` so `/lab` can render these
					same states against fixture data. Inlined here they only existed
					once somebody signed in to a live CMS and found an entry somebody
					else had already rated, which is how five states ship having never
					been looked at.
				*/}
				<SignalPanel
					subjectType="possibility"
					subjectSlug={p.slug}
					viewer={viewer}
					community={community}
					openReports={openReports}
				>
					<span slot="editorial" class="signal__value">
						{p.featured ? "Featured by a curator" : "Not featured"}
					</span>
					<span slot="machine" class="signal__value">
						{p.novelty === null && p.coverage === null
							? "Not measured"
							: `novelty ${p.novelty ?? "—"} · coverage ${p.coverage ?? "—"}`}
					</span>
					<p slot="machine-note" class="signal__note">
						{(p.distinctSources ?? 0) === 0
							? "No source has had its licence read yet, so there is nothing to measure against."
							: `${p.distinctSources} source licence(s) read at a specific commit.`}
					</p>
				</SignalPanel>

				<section aria-labelledby="rights">
					<h2 id="rights" class="section__title">Rights</h2>
					{
						p.rightsStatus && (
							<p class="rights__status" style={`--c: var(--rights-${p.rightsStatus})`}>
								<span class="rights__dot" aria-hidden="true" />
								<strong>{rightsLabelFor(p.rightsStatus)}</strong>
								<span class="rights__meaning">
									{RIGHTS_MEANING[p.rightsStatus as keyof typeof RIGHTS_MEANING]}
								</span>
							</p>
						)
					}
					{p.rightsNote && <p class="rights__note">{p.rightsNote}</p>}
					<p class="rights__disclaimer">
						Possibility discovery does not grant rights to the source asset. Read the licence
						on the original before you reuse anything.
						<a href="/pages/licensing">How rights are classified</a>.
					</p>
				</section>
			</div>
		</div>

		/*
			Examples and their use states (#42). The list stays media-first and the
			use block sits inside each row, because a reader who has to leave the
			page to find out whether a file is reusable will not find out. The
			counts above come from these same examples.
		*/
		{
			examples.length > 0 && (
				<section class="examples shell" aria-labelledby="examples-title">
					<h2 id="examples-title" class="tag tag-rule">Examples · {examples.length}</h2>
					<p class="examples__summary" data-use-summary={summaryLine(useSummary)}>
						{summaryLine(useSummary)} ·{" "}
						<a class="examples__use-link" href={assetUsePaths.use(p.slug)}>
							What may be used, and what it costs
						</a>
					</p>
					<ul class="examples__list">
						{examples.map((example) => (
							<li class="example">
								<div class="example__media">
									<img
										src={mediaSrc(example, src)}
										alt={example.title}
										width="800"
										height="1000"
										loading="lazy"
										decoding="async"
									/>
								</div>
								<div class="example__body">
									<h3 class="example__title">{example.title}</h3>
									<ProvenanceMarkers
										rights={example.rightsStatus}
										origin={example.origin}
										size="sm"
									/>
									{example.origin && (
										<p class="example__origin">
											{ORIGIN_MEANING[example.origin as keyof typeof ORIGIN_MEANING]}
										</p>
									)}
									{example.note && <p class="example__note">{example.note}</p>}
								</div>
								{/*
								 * Full width under the media and the label, not squeezed into the
								 * label column: the actions and the credit block need room to be
								 * read rather than scrolled.
								 */}
								<ExampleUse example={example} />
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			related.length > 0 && (
				<section class="related shell" aria-labelledby="related-title">
					<h2 id="related-title" class="tag tag-rule">Related possibilities</h2>
					<div class="related__grid">
						{related.map((r) => (
							<PossibilityTile possibility={r} />
						))}
					</div>
				</section>
			)
		}
	</article>
</Base>

<style>
	.detail {
		display: grid;
	}

	/* The answer to the rating or report the reader just sent, pinned above the
	   header so it is on screen when the redirect lands. The header then loses its
	   top padding, which is where the flash's own padding went. */
	.outcome {
		padding-block: var(--sp-4) 0;
	}

	.outcome + .head {
		padding-block-start: var(--sp-4);
	}

	/* --- Header --- */

	.head {
		display: grid;
		gap: var(--sp-4);
		padding-block: var(--sp-5) var(--sp-6);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.1rem 0.5rem;
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-4);
	}

	/* Padding, not type size, carries the tap target: breadcrumb type is
	   intentionally small so the hierarchy stays readable. */
	.crumbs a,
	.crumbs__here {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		padding-inline: 0.15rem;
	}

	.crumbs a {
		color: var(--ink-3);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.crumbs a:hover {
		color: var(--ink);
	}

	.crumbs__here {
		color: var(--ink-2);
	}

	.head__title {
		font-size: var(--step-4);
		max-width: 24ch;
	}

	.head__tagline {
		font-size: var(--step-1);
		color: var(--ink-2);
		max-width: 54ch;
		text-wrap: pretty;
	}

	.head__marks {
		margin-top: calc(var(--sp-2) * -1);
	}

	.head__summary {
		margin-top: var(--sp-2);
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-4) var(--sp-7);
		margin-top: var(--sp-4);
		padding-top: var(--sp-4);
		border-top: 1px solid var(--line);
	}

	.facts dt {
		margin-bottom: 0.15rem;
	}

	.facts dd {
		display: flex;
		align-items: center;
		min-height: 1.9rem;
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 600;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.facts dd a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
	}

	.facts a:hover {
		color: var(--ember);
	}

	/* --- Body: plate beside prose --- */

	.body {
		display: grid;
		gap: var(--sp-6);
		padding-block: var(--sp-5) var(--sp-7);
		border-top: 1px solid var(--line);
	}

	.plate {
		display: grid;
		gap: var(--sp-3);
		align-content: start;
	}

	.plate img {
		width: 100%;
		height: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.plate figcaption {
		color: var(--ink-4);
	}

	.prose-col {
		display: grid;
		gap: var(--sp-6);
		align-content: start;
		max-width: var(--measure);
	}

	.prose-col p {
		color: var(--ink-2);
		line-height: 1.62;
		text-wrap: pretty;
	}

	.section__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-2);
		letter-spacing: -0.02em;
		color: var(--ink);
		margin-bottom: var(--sp-3);
	}

	.section__hint {
		font-size: var(--step--1);
		color: var(--ink-4);
		margin-top: calc(var(--sp-2) * -1);
		margin-bottom: var(--sp-3);
	}

	.scaffold {
		display: grid;
		gap: var(--sp-2);
		margin: 0;
		padding: var(--sp-4);
		background: var(--surface);
		border: 1px solid var(--line);
		border-left: 2px solid var(--ember-line);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		line-height: 1.6;
		color: var(--ink-2);
	}

	/* --- Rights --- */

	.rights__status {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.35rem 0.7rem;
		align-items: baseline;
		padding: var(--sp-4);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.rights__dot {
		grid-row: 1 / 3;
		align-self: center;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--c);
	}

	.rights__status strong {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.rights__meaning {
		font-size: var(--step--1);
		color: var(--ink-3);
		line-height: 1.5;
	}

	.rights__note {
		font-size: var(--step--1);
	}

	.rights__disclaimer {
		font-size: var(--step--1);
		color: var(--ink-4);
		padding-top: var(--sp-3);
		border-top: 1px solid var(--line);
	}

	/* Inline in a sentence, so it keeps sentence spacing rather than the tap
	   minimum: WCAG 2.2's inline exception, and the same reason a link in body
	   copy is never padded to 44px. `npm run check:visual` exempts links inside
	   prose for exactly this reason. */
	.rights__disclaimer a {
		display: inline-flex;
		align-items: center;
		min-height: 1.75rem;
		color: var(--ink-2);
		text-decoration: underline;
		text-decoration-color: var(--ember-line);
		text-underline-offset: 3px;
	}

	/* --- Examples --- */

	.examples,
	.related {
		padding-block: var(--sp-7);
		border-top: 1px solid var(--line);
	}

	.examples__list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--sp-4);
		margin-top: var(--sp-5);
	}

	.example {
		display: grid;
		gap: var(--sp-4);
		padding: var(--sp-4);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.example__media img {
		width: 100%;
		max-width: 15rem;
		height: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.example__body {
		display: grid;
		gap: var(--sp-3);
		align-content: start;
	}

	.example__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-1);
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.example__origin,
	.example__note {
		font-size: var(--step--1);
		color: var(--ink-3);
		line-height: 1.55;
		max-width: 62ch;
	}

	/* The honest count, stated once, above the rows it counts. */
	.examples__summary {
		margin-top: var(--sp-3);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--ink-3);
	}

	/* A standalone action, not a link inside a sentence, so it carries the full
	   touch target rather than the inline exemption. */
	.examples__use-link {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
		color: var(--ink-2);
		text-decoration: underline;
		text-decoration-color: var(--ember-line);
		text-underline-offset: 3px;
	}

	.examples__use-link:hover {
		color: var(--ink);
	}

	.related__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
		gap: var(--sp-5) var(--sp-4);
		margin-top: var(--sp-5);
	}

	/*
	 * Two conditions, not one.
	 *
	 * `width >= 860px` is the layout switch: below it the plate is a band above
	 * the prose, and a sticky band is worse than a static one.
	 *
	 * `height >= 46rem` is why the drill-in was unusable in landscape. A sticky
	 * element taller than the viewport parks its top and hides its bottom
	 * permanently — no scroll offset shows all of it. At 896×414 and 932×430,
	 * which is where a phone is actually held sideways, the plate measured
	 * 471–491px in a 414–430px viewport: 129–133px of the specimen, which is the
	 * content of this page, was off the screen at every offset. Below this height
	 * the plate scrolls with the prose and every row of the diagram is reachable.
	 */
	@media (width >= 860px) and (height >= 46rem) {
		.body {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			gap: var(--sp-7);
		}

		.plate {
			position: sticky;
			top: calc(var(--masthead-h) + var(--sp-4));
			align-self: start;
		}

		.example {
			grid-template-columns: 12rem minmax(0, 1fr);
			align-items: start;
		}
	}

	/* Full-width use block: the label column is 12rem, which is room for a title
	   and not for an obligation. */
	.example > .use {
		grid-column: 1 / -1;
	}
</style>
