---
/**
 * The catalogue wall — the product's primary surface.
 *
 * Filtering happens server-side against the CMS query so the initial render is
 * already correct (works without JS, shareable URLs), and client-side only to
 * hide tiles that no longer match. The two paths must agree: `?vertical=` is
 * the source of truth, and the toggle writes to it.
 */
import Base from "../layouts/Base.astro";
import PossibilityTile from "../components/PossibilityTile.astro";
import OutcomeFlash from "../components/OutcomeFlash.astro";
import { PortableText } from "emdash/ui";
import { loadPossibilities, tallyVerticals } from "../lib/catalogue";
import { loadIntro } from "../lib/site-shell";
import { runApp } from "../lib/effect/root";
import { COOKIE_NAME, boardOutcome, boardTotals, parseBoards } from "../lib/board";
import { RIGHTS_LABEL, RIGHTS_MEANING, verticalLabel } from "../lib/vocabulary";

const { possibilities, cacheHint } = await runApp(loadPossibilities(), { signal: Astro.request.signal });
// `cacheHint` is absent when EmDash had nothing to say — a query that failed
// is now a typed failure rather than an empty page, so there is no hint to set.
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

/**
 * The opening sentence is CMS content, not a literal in this file.
 *
 * It was one, and `seed/atlas.json` declared a `field-guide-intro` section that
 * nothing read — which is the arrangement #17 forbids and the one an owner
 * discovers when they edit the obvious field in the admin and the wall does not
 * change. The section is read now; see `src/lib/site-shell.ts`.
 *
 * Rendering goes through EmDash's own `PortableText`, so an edit in the admin
 * can carry the marks the CMS supports rather than the two sentences this file
 * happened to have.
 */
const intro = await runApp(loadIntro(), { signal: Astro.request.signal });
if (intro.source === "fallback") {
	console.warn(`wall intro: rendering the built-in sentence — ${intro.note}`);
}

const verticals = tallyVerticals(possibilities);
const requested = Astro.url.searchParams.get("vertical");
const activeVertical = verticals.find((v) => v.slug === requested)?.slug ?? null;

const filtered = activeVertical
	? possibilities.filter((p) => p.vertical === activeVertical)
	: possibilities;

// Density ramp: the first entry of the unfiltered wall gets a lead tile that
// spans two columns and two rows of the same grid. A filtered view is already
// narrow, so the ramp does not apply there — one big tile among three would
// read as a mistake rather than as emphasis.

// The board lives in a cookie, so the server already knows what is saved and the
// tile can render its real state on the first paint rather than after hydration.
const boards = parseBoards(Astro.cookies.get(COOKIE_NAME)?.value);
const board = Object.keys(boards).find((name) => boards[name].length) ?? "default";
const savedHere = new Set(boards[board] ?? []);
const totals = boardTotals(boards);

/*
 * The answer to the save the reader just made, read back from the redirect. The
 * `+` on the tile flips to a `✓`, which is feedback a sighted reader gets for
 * free; without this, a keyboard reader and a screen-reader reader got a page
 * reload and nothing at all.
 */
const bySlug = new Map(possibilities.map((p) => [p.slug, p.title]));
const outcome = boardOutcome(Astro.url.searchParams, (slug) => bySlug.get(slug));

const rightsTally = new Map<string, number>();
for (const p of filtered) {
	if (p.rightsStatus) rightsTally.set(p.rightsStatus, (rightsTally.get(p.rightsStatus) ?? 0) + 1);
}
---

<Base
	title="Catalogue"
	description="A field guide to what can be made — distinct creative and technical possibilities across games, UI, branding, motion, audio, 3D, shaders, code and architecture, each with representative examples and their rights."
	path="/"
>
	{/*
		The intro is a band, not a hero. Its whole job is to say what this is and
		get out of the way: DESIGN.md §5 puts one region above the grid, and the
		fold check in `npm run check:visual` fails if the plates start below it.

		One of the three lines is CMS content: the sentence under the title, from
		the `field-guide-intro` section. The eyebrow and the `<h1>` stay literals,
		and both are deliberate. The eyebrow is a mono label — design chrome in the
		voice the rest of the site uses for one, not prose anybody needs to edit.
		The `<h1>` is the document's title, which `Base.astro` needs before this
		band exists, and an `<h1>` that vanished with a database read failure would
		leave a page with no heading at all. The section can restate the title; it
		cannot replace it.

		`data-intro-source` says which of the two rendered, for the same reason
		`data-nav-source` exists on the masthead: a CMS field that silently stops
		being read is the failure this whole change is about.
	*/}
	<section class="intro shell">
		<div class="intro__body" data-intro-source={intro.source}>
			<p class="tag tag--ember">Option space, compressed</p>
			<h1 class="display intro__title">
				What can be made, and the ways it has already been made
			</h1>
			<div class="lede intro__lede">
				<PortableText value={intro.blocks as never} />
			</div>
		</div>
		<dl class="tally">
			<div>
				<dt class="tag">Possibilities</dt>
				<dd class="tally__n">{possibilities.length}</dd>
			</div>
			<div>
				<dt class="tag">Verticals</dt>
				<dd class="tally__n">{verticals.length}</dd>
			</div>
			<div>
				<dt class="tag">
					Verified sources
					<span class="visually-hidden">counted against a licence read at the source</span>
				</dt>
				<dd class="tally__n">{possibilities.reduce((n, p) => n + (p.distinctSources ?? 0), 0)}</dd>
			</div>
		</dl>
	</section>

	<nav class="rail shell" aria-label="Filter by vertical">
		<h2 class="visually-hidden">Filter by vertical</h2>
		<ul class="rail__list" data-rail data-scroll-strip>
			<li>
				<a
					href="/"
					class:list={["chip", { "chip--on": !activeVertical }]}
					data-vertical=""
					aria-current={!activeVertical ? "true" : undefined}
				>
					All<span class="chip__n">{possibilities.length}</span>
				</a>
			</li>
			{
				verticals.map((v) => (
					<li>
						<a
							href={`/?vertical=${v.slug}`}
							class="chip"
							data-vertical={v.slug}
							aria-current={activeVertical === v.slug ? "true" : undefined}
						>
							<span data-label>{verticalLabel(v.slug)}</span>
							<span class="chip__n">{v.count}</span>
						</a>
					</li>
				))
			}
		</ul>
		{/*
		 * The filter is applied in place, so the wall does not reload and nothing
		 * tells a screen reader that the result set changed. This is the only place
		 * that can know: it counts what it just hid. `role="status"` because it is
		 * a polite, non-interrupting update — the reader chose the filter and knows
		 * why they are waiting.
		*/}
		<p class="visually-hidden" role="status" data-filter-status>
			{`Showing all ${possibilities.length} possibilities.`}
		</p>
	</nav>

	<section class="wall shell" aria-label="Possibilities">
		{
			filtered.length === 0 ? (
				<div class="empty">
					<h2 class="display empty__title">Nothing catalogued yet</h2>
					<p class="lede">
						No possibilities are published in this vertical. That is an accurate empty state
						rather than a loading failure — try another vertical.
					</p>
					<a class="button" href="/">
						Show every vertical
					</a>
				</div>
			) : (
				<div class="grid" data-grid>
					{filtered.map((p, i) => (
						<PossibilityTile
							possibility={p}
							featured={i === 0 && !activeVertical}
							hideVertical={false}
							eager={i < 4}
							board={board}
							savedToBoard={savedHere.has(p.slug)}
						/>
					))}
				</div>
			)
		}
	</section>

	{
		outcome && (
			<div class="shell outcome">
				<OutcomeFlash message={outcome.message} tone={outcome.tone} />
			</div>
		)
	}

	{
		totals.items > 0 && (
			<nav class="boardbar shell" aria-label="Shortlist">
				{/*
				 * No `role="status"` here. It was one, and it announced the saved
				 * count on every page load — the same words, every time, before the
				 * reader had done anything. The answer to the action they *did* take
				 * is the flash above; this line is a static fact about their cookie.
				 */}
				<p class="boardbar__count">
					{totals.items} {totals.items === 1 ? "possibility" : "possibilities"} saved
					{totals.boards > 1 ? ` across ${totals.boards} boards` : ""}
				</p>
				<a class="button" href="/board">
					Open the board
				</a>
			</nav>
		)
	}

	<aside class="legend shell" aria-labelledby="legend-title">
		<h2 id="legend-title" class="tag">Reading the marks</h2>
		<div class="legend__grid">
			{
				[...rightsTally.entries()].map(([status, count]) => (
					<div class="legend__row">
						<span class="legend__dot" style={`--c: var(--rights-${status})`} aria-hidden="true" />
						<div>
							<p class="legend__label">
								{RIGHTS_LABEL[status as keyof typeof RIGHTS_LABEL]} · {count}
							</p>
							<p class="legend__meaning">{RIGHTS_MEANING[status as keyof typeof RIGHTS_MEANING]}</p>
						</div>
					</div>
				))
			}
			<div class="legend__row">
				<span class="legend__dot legend__dot--hollow" style="--c: var(--origin-generated)" aria-hidden="true" />
				<div>
					<p class="legend__label">Generated · {filtered.length}</p>
					<p class="legend__meaning">
						Every plate here was generated for this catalogue. Upstream examples, shown
						directly from discovered material, will appear alongside them and are labelled
						differently.
					</p>
				</div>
			</div>
		</div>
	</aside>

	<script>
		/**
		 * The filter, applied in place.
		 *
		 * The server already filtered correctly, so this only has to make toggling
		 * between verticals feel instant rather than making it work. Three things
		 * make it honest rather than merely fast, and each was a real failure:
		 *
		 * 1. **The chips follow the filter.** It used to hide tiles and leave every
		 *    chip's selected state exactly as the server had rendered it, so after
		 *    choosing Games the rail still said "All" was active while the URL and
		 *    the grid said Games. Two controls disagree on screen and in the
		 *    accessibility tree.
		 * 2. **The result count is announced.** Hiding tiles changes the page with
		 *    no navigation and no announcement, which is the case `role="status"`
		 *    exists for.
		 * 3. **Back and forward re-apply the filter.** The URL is the filter
		 *    (DESIGN.md §9.1), so a `popstate` that moves off `?vertical=` has to
		 *    put the tiles back. It did not: pressing Back left three of
		 *    twenty-four tiles on screen under an unfiltered URL, with no way to
		 *    recover but a reload.
		 */
		const list = document.querySelector<HTMLElement>("[data-rail]");
		const grid = document.querySelector<HTMLElement>("[data-grid]");
		const status = document.querySelector<HTMLElement>("[data-filter-status]");
		const chips = list
			? Array.from(list.querySelectorAll<HTMLAnchorElement>(".chip"))
			: [];

		if (list && grid && chips.length) {
			const tiles = Array.from(grid.querySelectorAll<HTMLElement>(".tile"));

			const verticalLabelFor = (slug: string) => {
				const chip = chips.find((c) => c.dataset.vertical === slug);
				return chip?.querySelector("[data-label]")?.textContent?.trim() ?? "";
			};

			const applyFilter = (slug: string) => {
				const all = slug === "";
				let shown = 0;
				for (const tile of tiles) {
					const matches = all || tile.dataset.vertical === slug;
					tile.hidden = !matches;
					if (matches) shown++;
				}
				// The rail's own state, not the server's: the two disagree the moment
				// the reader chooses differently from the URL they arrived on.
				for (const chip of chips) {
					const on = (chip.dataset.vertical ?? "") === slug;
					chip.classList.toggle("chip--on", on);
					if (on) chip.setAttribute("aria-current", "true");
					else chip.removeAttribute("aria-current");
				}
				if (status) {
					status.textContent = all
						? `Showing all ${shown} possibilities.`
						: `Showing ${shown} ${shown === 1 ? "possibility" : "possibilities"} in ${verticalLabelFor(slug)}.`;
				}
				return shown;
			};

			/** The slug the address bar is asking for, or "" for the whole wall. */
			const slugFromUrl = () => {
				const requested = new URL(location.href).searchParams.get("vertical");
				return chips.some((c) => (c.dataset.vertical ?? "") === requested)
					? (requested ?? "")
					: "";
			};

			list.addEventListener("click", (event) => {
				const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[data-vertical]");
				if (!link) return;
				const slug = link.dataset.vertical ?? "";
				// Only intercept when every tile for that vertical is already in the
				// DOM; otherwise let the link navigate and let the server be right.
				if (slug && !tiles.some((t) => t.dataset.vertical === slug)) return;
				event.preventDefault();
				const next = new URL(location.href);
				if (slug) next.searchParams.set("vertical", slug);
				else next.searchParams.delete("vertical");
				if (next.href !== location.href) history.pushState(null, "", next.href);
				const shown = applyFilter(slug);
				document.dispatchEvent(new CustomEvent("wall:filter", { detail: { slug, shown } }));
			});

			addEventListener("popstate", () => {
				const slug = slugFromUrl();
				applyFilter(slug);
				document.dispatchEvent(new CustomEvent("wall:filter", { detail: { slug } }));
			});

			// Reconcile on load, so a restored bfcache page or a client-side
			// navigation lands on the state its URL describes.
			applyFilter(slugFromUrl());
		}
	</script>
</Base>

<style>
	.intro {
		display: grid;
		gap: var(--sp-4);
		padding-block: clamp(var(--sp-5), 3vw, var(--sp-6)) var(--sp-4);
	}

	.intro__body {
		display: grid;
		gap: var(--sp-3);
	}

	/* Sized against the fold, not against a marketing page: at 1280 this is
	   ~60px, so the title stays two lines and the plates still start inside
	   the first viewport. */
	.intro__title {
		font-size: clamp(1.75rem, 1.2rem + 3.4vw, 3.4rem);
		max-width: 24ch;
	}

	.intro__lede {
		font-size: var(--step-0);
		max-width: 58ch;
		color: var(--ink-3);
	}

	.tally {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--sp-3) var(--sp-4);
		margin-top: var(--sp-3);
		padding-top: var(--sp-3);
		border-top: 1px solid var(--line);
	}

	.tally dt {
		margin-bottom: 0.15rem;
	}

	.tally__n {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-2);
		line-height: 1;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	/* --- Filter rail --- */

	.rail {
		position: sticky;
		/*
		 * `--masthead-h`, not a literal. The masthead is two rows below 860px and
		 * one above it, and a rail that sticks at a fixed 3.5rem is sliced in half
		 * by the masthead on every phone and tablet. The token is the measured
		 * height; the check that keeps it honest is in `scripts/visual-qa.mjs`
		 * ("sticky rail under the masthead").
		 */
		top: var(--masthead-h);
		z-index: 30;
		padding-block: var(--sp-3);
		background: color-mix(in srgb, var(--canvas) 92%, transparent);
		backdrop-filter: blur(14px);
		border-block: 1px solid var(--line);
	}

	.rail__list {
		display: flex;
		gap: var(--sp-2);
		list-style: none;
		padding: 0 0 var(--sp-1);
		overflow-x: auto;
		scrollbar-width: thin;
		scroll-snap-type: x proximity;
	}

	.rail__list[data-scroll="end"] {
		mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
	}

	.rail__list[data-scroll="start"] {
		mask-image: linear-gradient(to right, transparent, #000 3rem);
	}

	.rail__list[data-scroll="both"] {
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 3rem,
			#000 calc(100% - 3rem),
			transparent
		);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		/* The rail is the primary filter on a touch device, so the chips are the
		   touch targets: 33px was below the 44px floor DESIGN.md §7 sets. */
		min-height: var(--tap);
		padding: 0.35rem 0.75rem;
		background: transparent;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: 0.04em;
		text-transform: capitalize;
		color: var(--ink-2);
		white-space: nowrap;
		scroll-snap-align: start;
		transition: color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
	}

	.chip:hover {
		color: var(--ink);
		border-color: var(--line-loud);
	}

	.chip--on {
		color: var(--canvas);
		background: var(--ember);
		border-color: var(--ember);
	}

	.chip__n {
		font-size: 0.85em;
		color: var(--ink-4);
		font-variant-numeric: tabular-nums;
	}

	.chip--on .chip__n {
		color: color-mix(in srgb, var(--canvas) 70%, transparent);
	}

	/* --- Wall --- */

	.wall {
		padding-block: var(--sp-6) var(--sp-7);
	}

	/* One grid, one ramp. The lead tile is two columns and two rows of the same
	   grid rather than a separate band above it: a separate band left a hole
	   beside a single wide tile, and it changed the plate's aspect ratio, which
	   crops the annotations off a diagram. */
	.grid {
		display: grid;
		/* Media-first: the tile size is set by the plate, not by a card. */
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: var(--sp-5) var(--sp-4);
	}

	.grid :global(.tile[hidden]) {
		display: none;
	}

	/* --- Empty state --- */

	.empty {
		display: grid;
		gap: var(--sp-4);
		justify-items: start;
		padding-block: var(--sp-8);
		max-width: var(--measure);
	}

	.empty__title {
		font-size: var(--step-3);
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.6rem 1.1rem;
		background: var(--ember);
		color: var(--canvas);
		border: 1px solid var(--ember);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.04em;
		transition: background var(--dur-fast) var(--ease-out);
	}

	.button:hover {
		background: color-mix(in srgb, var(--ember) 86%, white);
	}

	/* --- Shortlist bar ---------------------------------------------------- */

	/* Where a POST's answer goes: directly under the masthead, above the
	   catalogue, because it is the answer to something the reader just pressed and
	   it should not need scrolling to find. */
	.outcome {
		padding-block: var(--sp-4) 0;
	}

	.boardbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-3);
		padding-block: var(--sp-3);
		border-top: 1px solid var(--ember-line);
	}

	.boardbar__count {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--ink-2);
	}

	/* --- Rights legend --- */

	.legend {
		padding-block: var(--sp-6);
		border-top: 1px solid var(--line);
	}

	.legend__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: var(--sp-4) var(--sp-6);
		margin-top: var(--sp-4);
	}

	.legend__row {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--sp-3);
		align-items: start;
	}

	.legend__dot {
		width: 0.6rem;
		height: 0.6rem;
		margin-top: 0.35rem;
		border-radius: 50%;
		background: var(--c);
	}

	.legend__dot--hollow {
		background: none;
		box-shadow: inset 0 0 0 1.5px var(--c);
	}

	.legend__label {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--ink);
		margin-bottom: 0.2rem;
	}

	.legend__meaning {
		font-size: var(--step--1);
		color: var(--ink-3);
		line-height: 1.5;
		max-width: 46ch;
	}

	@media (width >= 900px) {
		/* Title block left, honest counts right. Two columns instead of one tall
		   column is what keeps the plates inside the first viewport. */		.intro {
			grid-template-columns: minmax(0, 1.7fr) minmax(15rem, 0.8fr);
			align-items: end;
			gap: var(--sp-7);
		}

		.tally {
			grid-template-columns: 1fr;
			gap: 0;
			margin-top: 0;
			padding-top: 0;
			border-top: 0;
			border-left: 1px solid var(--line);
			padding-left: var(--sp-5);
		}

		.tally > div {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: var(--sp-4);
			padding-block: var(--sp-2);
		}

		.tally > div + div {
			border-top: 1px solid var(--line);
		}

		.tally dt {
			margin-bottom: 0;
		}

		/* Two columns and two rows: 2 × 285px wide at 4:5 lands within a few
		   pixels of two 356px rows, so the grid resolves without empty cells. */
		.grid > :global(.tile--featured) {
			grid-column: span 2;
			grid-row: span 2;
		}

		.grid {
			gap: var(--sp-6) var(--sp-5);
		}
	}

	/* A phone gets the same rule harder: the masthead already costs 88px, so
	   the intro has to give the rest of the fold to plates. */
	@media (width <= 560px) {
		.intro {
			padding-block: var(--sp-4) var(--sp-3);
		}

		.intro__title {
			font-size: clamp(1.625rem, 7vw, 1.875rem);
		}

		.intro__lede {
			font-size: var(--step--1);
		}

		.tally {
			margin-top: var(--sp-2);
			padding-top: var(--sp-2);
		}
	}

	/*
	 * Landscape phone: the short-window case.
	 *
	 * At 844×390 the wall opened with 515px of type above the first plate — 132%
	 * of the fold, so a reader arriving at a rotated phone saw nothing but a
	 * headline and had to scroll to discover there was a catalogue. The chrome
	 * (masthead + rail) is 123px of a 390px window, which leaves very little for
	 * the intro band, and DESIGN.md §5b's whole point is that this band is not a
	 * hero.
	 *
	 * So the band gets compact rather than hidden: the title takes its size from
	 * the viewport height, the lede goes to label size, and — once there is width
