---
/**
 * The shortlist board and the compare view (#36).
 *
 * Discovery ends with a choice, so this is where the choice happens. Two rules
 * shape it:
 *
 * 1. **Comparison is media-first.** The plates sit side by side at the same size
 *    with the same representative treatment, because a comparison where one entry
 *    is larger than the others has already told you the answer. Everything
 *    numeric goes behind a disclosure, opened per entry.
 * 2. **Nothing here needs JavaScript.** Every action is a form POST, so a board
 *    works with the same input a keyboard and a finger produce.
 *
 * The board is stored in a cookie. See `src/lib/board.ts` for what that does and
 * does not buy.
 */
import Base from "../../layouts/Base.astro";
import PossibilityTile from "../../components/PossibilityTile.astro";
import OutcomeFlash from "../../components/OutcomeFlash.astro";
import BoardSwitcher from "../../components/BoardSwitcher.astro";
import { loadPossibilities } from "../../lib/catalogue";
import { runApp } from "../../lib/effect/root";
import { MEDIA_LABEL, RIGHTS_MEANING, verticalLabel } from "../../lib/vocabulary";
import {
	COOKIE_NAME,
	DEFAULT_BOARD,
	MAX_PER_BOARD,
	boardCanManage,
	boardOutcome,
	boardTotals,
	normaliseBoardName,
	parseBoards,
} from "../../lib/board";

const boards = parseBoards(Astro.cookies.get(COOKIE_NAME)?.value);
const requested = normaliseBoardName(Astro.url.searchParams.get("board"));
const active = boards[requested] ? requested : DEFAULT_BOARD;
const slugs = boards[active] ?? [];
const totals = boardTotals(boards);
const back = "/board";

const { possibilities } = await runApp(loadPossibilities(), { signal: Astro.request.signal });
const bySlug = new Map(possibilities.map((p) => [p.slug, p]));
// Only what is in the catalogue survives: a cookie naming something else is
// dropped here rather than rendered.
const items = slugs.map((slug) => bySlug.get(slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const dropped = slugs.length - items.length;

/*
 * Whether this board can be *managed*, decided by the same rule the POST
 * endpoint applies (#65). It counts what actually rendered rather than what the
 * cookie names, so a board whose every slug the catalogue has since dropped is
 * correctly unmanageable — there is nothing left to copy, clear or export, and a
 * control that offers to do any of them is a claim the record does not support.
 */
const manageable = boardCanManage(items.length);

/*
 * The answer to the POST that sent the reader here. It used to be inferred from
 * membership — "did you just save this?" — which is why saving said something and
 * unsaving, removing and clearing all said nothing at all, including the two
 * actions that destroy work.
 *
 * `keptElsewhere` is what makes the cleared sentence true: clearing empties the
 * board being looked at and leaves the reader's other boards alone, so "nothing
 * was kept anywhere else" was only ever true when they had no other boards.
 */
const outcome = boardOutcome(Astro.url.searchParams, (slug) => bySlug.get(slug)?.title, {
	keptElsewhere: totals.items,
});
---

<Base
	title="Shortlist"
	description="Compare the possibilities you are considering, side by side, with their sources and rights on demand."
	path="/board"
	noindex
>
	{
		/*
		 * The header only exists when there is something to head. An empty board
		 * used to get a headline here ("Nothing saved yet"), a live copy form, and
		 * then a *second* headline and a second explanation 180px lower down
		 * (#65) — two answers to one state, the second of which contradicted the
		 * first about whether anything was missing. So the loaded board keeps the
		 * header and the empty board gets one self-contained state below, and the
		 * `h1` moves with it: one headline on the page either way, and never a
		 * heading level that skips.
		 */
		manageable && (
			<header class="head shell">
				<p class="tag tag--ember">Shortlist</p>
				<h1 class="display head__title">{items.length} to choose between</h1>
				<p class="lede">
					Plates side by side at the same size. Source, licence and technique are behind each
					one, because a comparison that starts with metadata is a comparison you have already
					lost.
				</p>

				<BoardSwitcher boards={boards} active={active} manageable={manageable} />

				<form class="newboard" method="post" action="/api/board">
					<input type="hidden" name="action" value="rename" />
					<input type="hidden" name="board" value={active} />
					<input type="hidden" name="back" value={back} />
					<label class="visually-hidden" for="to">New board name</label>
					<input
						id="to"
						type="text"
						name="to"
						placeholder="Copy this board to a new name"
						maxlength="40"
						autocomplete="off"
					/>
					<button type="submit">Copy board</button>
				</form>
			</header>
		)
	}

	<div class="results shell">
		{
			outcome && <OutcomeFlash message={outcome.message} tone={outcome.tone} />
		}
		{
			dropped > 0 && (
				<p class="flash" role="status">
					{dropped} saved {dropped === 1 ? "entry names" : "entries name"} something the
					catalogue does not have, so {dropped === 1 ? "it was" : "they were"} dropped rather
					than shown.
				</p>
			)
		}

		{
			items.length === 0 ? (
				/*
				 * The empty board, and the whole of what it is (#65). The copy form
				 * is not disabled and not greyed out — it is *absent*, because with
				 * no entries on the board it copies nothing, and DESIGN.md §9.6 says
				 * a control that cannot be used is a claim about the record and
				 * claims about the record are made in words: the way in is the answer
				 * here, not a management control for a board that does not exist yet.
				 *
				 * It reappears on its own once there is something to copy, because it
				 * is gated on `manageable` above rather than hidden per-state.
				 */
				<div class="empty">
					<p class="tag tag--ember">Shortlist</p>
					{/*
					 * `head__title` as well as `empty__title`: the same type class as the
					 * loaded board's headline, so the empty state is not quietly a smaller
					 * page than the loaded one. `DESIGN.md` §8 asks for a state
					 * indistinguishable in quality, and a headline three steps down the
					 * fluid scale is the easiest way to fail that without writing a
					 * sentence about it. `empty__title` stays as the hook `check:visual`
					 * counts to prove the empty state rendered.
					 */}
					<h1 class="display head__title empty__title">This board is empty</h1>
					<p class="lede">
						Nothing has been saved to it yet, which is a real state with a real answer rather
						than a failure. Press the + on any plate to keep it here — it appears when you point
						at a tile, and is always there on a touch screen or a keyboard. The list lives in
						this browser, so nothing is uploaded and nothing follows you to another machine.
					</p>
					<div class="empty__links">
						<a class="button" href="/">Open the wall</a>
						<a class="button button--ghost" href="/verticals">Browse verticals</a>
					</div>

					{/*
					 * The switcher sits *after* the way in, never above it, and it
					 * renders only when there is another board to switch to — which is
					 * exactly the state a copy leaves behind. It is the one control an
					 * empty board still carries, because following a copy needs a way
					 * to follow it (#65).
					 */}
					<BoardSwitcher boards={boards} active={active} manageable={manageable} />
				</div>
			) : (
				<>
					<div class="compare">
						{items.map((p) => (
							<article class="entry">
								<PossibilityTile possibility={p} headingLevel="h2" />
								<p class="entry__summary">{p.summary}</p>
								<p class="entry__meta">
									<span class="tag">{verticalLabel(p.vertical)}</span>
									{p.mediaKind && (
										<span class="tag">{MEDIA_LABEL[p.mediaKind] ?? p.mediaKind}</span>
									)}
									<span class="tag">
										{p.exampleCount ?? 0} example{p.exampleCount === 1 ? "" : "s"}
									</span>
									<span class="tag">
										{p.distinctSources ?? 0} verified source
										{(p.distinctSources ?? 0) === 1 ? "" : "s"}
									</span>
								</p>
								<details class="entry__more">
									<summary class="tag">Source, licence and technique</summary>
									<dl class="facts">
										<div>
											<dt class="tag">Rights</dt>
											<dd>
												<strong>{p.rightsStatus ?? "unstated"}</strong>
												{p.rightsNote && <span class="facts__note">{p.rightsNote}</span>}
												{p.rightsStatus && (
													<span class="facts__meaning">
														{RIGHTS_MEANING[p.rightsStatus as keyof typeof RIGHTS_MEANING]}
													</span>
												)}
											</dd>
										</div>
										{p.technique && (
											<div>
												<dt class="tag">Technique</dt>
												<dd>{p.technique}</dd>
											</div>
										)}
										{p.buildNotes && (
											<div>
												<dt class="tag">Build notes</dt>
												<dd>{p.buildNotes}</dd>
											</div>
										)}
										{p.promptScaffold && (
											<div>
												<dt class="tag">Prompt scaffold</dt>
												<dd class="facts__mono">{p.promptScaffold}</dd>
											</div>
										)}
									</dl>
									<form method="post" action="/api/board" class="entry__actions">
										<input type="hidden" name="action" value="remove" />
										<input type="hidden" name="slug" value={p.slug} />
										<input type="hidden" name="board" value={active} />
										<input type="hidden" name="back" value={back} />
										<button type="submit" class="linkish">Remove from every board</button>
									</form>
								</details>
							</article>
						))}
					</div>

					<form method="post" action="/api/board" class="clear">
						<input type="hidden" name="action" value="clear" />
						<input type="hidden" name="board" value={active} />
						<input type="hidden" name="back" value={back} />
						{/*
						 * A disclosure rather than a confirm dialog: clearing is
						 * irreversible and there is no undo, so one press of a link that
						 * reads like the other linkish buttons should not do it. A
						 * `<details>` is the same two-tap shape as every other disclosure
						 * on the site, works with a keyboard and a screen reader, and
						 * needs no script.
						 */}
						<details>
							<summary class="linkish">Clear this board</summary>
							<p class="clear__warn">
								{items.length === 1 ? "The one entry" : `All ${items.length} entries`} on
								this board go. Other boards are not touched, and the plates stay on the
								wall.
							</p>
							<button type="submit" class="linkish linkish--danger">
								Yes, empty this board
							</button>
						</details>
					</form>

					<details class="export">
						<summary class="tag">Export this board</summary>
						<p class="export__note">
							JSON with the stable slugs, so a board keeps working when a better representative
							example is found later. Reimporting it into a fresh browser is a paste.
						</p>
						<textarea
							readonly
							rows="6"
							aria-label="Board export">{JSON.stringify(
								{ board: active, slugs: items.map((p) => p.slug) },
								null,
								"\t",
							)}</textarea
						>
					</details>
				</>
			)
		}
	</div>
</Base>

<style>
	.head {
		display: grid;
		gap: var(--sp-4);
		justify-items: start;
		padding-block: var(--sp-6) var(--sp-4);
	}

	/* The empty board has no header above it, so its state is the top of the
	   page. The lede was the only line between the headline and the actions and
	   it reads as a wall of prose without a little air. */
	.empty__title + .lede {
		margin-block-start: var(--sp-2);
	}

	.head__title {
		font-size: var(--step-3);
		max-width: 24ch;
	}

	.newboard {
		display: flex;
		gap: var(--sp-2);
		width: 100%;
		max-width: 34rem;
	}

	.newboard input {
		flex: 1 1 12rem;
		min-height: 2.75rem;
		padding: 0.5rem 0.8rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--step--1);
	}

	.newboard button {
		min-height: 2.75rem;
		padding: 0.5rem 1rem;
		background: var(--surface-2);
		border: 1px solid var(--line-loud);
		border-radius: var(--radius);
		color: var(--ink-2);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		cursor: pointer;
	}

	.newboard button:hover {
		color: var(--ink);
		border-color: var(--ember-line);
	}

	.results {
		padding-block: var(--sp-5) var(--sp-7);
	}

	.flash {
		margin-bottom: var(--sp-4);
		padding: var(--sp-3) var(--sp-4);
		border-left: 2px solid var(--ember-line);
		background: var(--surface);
		font-size: var(--step--1);
		color: var(--ink-2);
	}

	.flash a {
		color: var(--ember);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* A cookie naming something the catalogue does not have is a correction the
	   reader needs to hear about, so it carries the review amber. */
	.flash {
		border-left-color: var(--rights-review);
	}

	/* Same columns for every entry, so the plates are directly comparable and
	   one entry cannot win on size. */
	.compare {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: var(--sp-6) var(--sp-5);
	}

	.entry {
		display: grid;
		gap: var(--sp-3);
		align-content: start;
		min-width: 0;
	}

	.entry__summary {
		font-size: var(--step--1);
		line-height: 1.5;
		color: var(--ink-2);
	}

	.entry__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2) var(--sp-3);
	}

	.entry__more {
		border-top: 1px solid var(--line);
		padding-top: var(--sp-2);
	}

	.entry__more summary {
		cursor: pointer;
		min-height: var(--tap);
		padding-block: var(--sp-2);
		list-style: revert;
	}

	.facts {
		display: grid;
		gap: var(--sp-3);
		padding-top: var(--sp-2);
		font-size: var(--step--1);
		color: var(--ink-2);
	}

	.facts dt {
		margin-bottom: 0.2rem;
	}

	.facts dd {
		line-height: 1.5;
	}

	.facts__note,
	.facts__meaning {
		display: block;
		color: var(--ink-3);
	}

	.facts__meaning {
		margin-top: 0.25rem;
		font-size: var(--step--2);
	}

	.facts__mono {
		font-family: var(--font-mono);
		font-size: var(--step--2);
		line-height: 1.55;
		color: var(--ink-3);
	}

	.linkish {
		margin-top: var(--sp-3);
		padding: var(--sp-2) 0;
		min-height: var(--tap);
		background: none;
		border: 0;
		color: var(--ink-3);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	.linkish:hover {
		color: var(--ember);
	}

	/* The one irreversible control on the page, named as such. The ember is the
	   single accent and this is the highest-priority thing a reader can do to
	   their own list, so it keeps the accent rather than inventing a danger hue
	   the palette does not have. */
	.linkish--danger {
		color: var(--ember);
		text-decoration-color: var(--ember);
	}

	.clear__warn {
		margin-top: var(--sp-2);
		max-width: var(--measure);
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--ink-3);
	}

	.clear {
		margin-top: var(--sp-6);
		padding-top: var(--sp-4);
		border-top: 1px solid var(--line);
	}

	.export {
		margin-top: var(--sp-4);
	}

	.export summary {
		cursor: pointer;
		min-height: var(--tap);
		padding-block: var(--sp-2);
		list-style: revert;
	}

	.export__note {
		margin-top: var(--sp-2);
		max-width: var(--measure);
		font-size: var(--step--1);
		color: var(--ink-3);
	}

	.export textarea {
		width: 100%;
		max-width: 40rem;
		margin-top: var(--sp-3);
		padding: var(--sp-3);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink-2);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		line-height: 1.5;
	}

	.empty {
		display: grid;
		gap: var(--sp-4);
		justify-items: start;
		padding-block: var(--sp-7);
		max-width: var(--measure);
	}

	.empty__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.6rem 1.1rem;
		background: var(--ember);
		color: var(--canvas);
		border: 1px solid var(--ember);
		border-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		font-weight: 600;
	}

	.button--ghost {
		background: transparent;
		color: var(--ink-2);
		border-color: var(--line-loud);
	}

	.button--ghost:hover {
		color: var(--ink);
	}
</style>