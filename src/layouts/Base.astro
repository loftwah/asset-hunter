---
/**
 * Base layout. Owns the document shell, the masthead, the skip link and the
 * footer. Global tokens are imported here so no page can accidentally render
 * unstyled.
 *
 * ## The masthead is CMS content
 *
 * The navigation used to be an array literal in this file, duplicating the
 * `primary` menu that `seed/seed.json` declares and that nothing read — so
 * editing the menu in the EmDash admin changed nothing a reader could see. It
 * is read from EmDash now; see `src/lib/site-shell.ts` for the fallback and why
 * the fallback is marked rather than hidden.
 */
import Wordmark from "../components/Wordmark.astro";
import { loadPrimaryNav, isCurrentLink } from "../lib/site-shell";
import { runApp } from "../lib/effect/root";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Canonical path, used for the OG URL and canonical link. */
	path?: string;
	ogImage?: string;
	/** Hide the masthead on pages that provide their own full-bleed header. */
	bare?: boolean;
	noindex?: boolean;
}
const { title, description, path, ogImage = "/og.png", bare = false, noindex = false } = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).href;
const fullTitle = path && path !== "/" ? `${title} — Asset Hunter` : "Asset Hunter — A field guide to what can be made";

const nav = await runApp(loadPrimaryNav(), { signal: Astro.request.signal });
// Passed straight to Astro so an admin edit purges the rendered route. Without
// it, a page cached before the edit keeps serving the old navigation and the
// edit looks like it did nothing — which is what it did, for a while.
if (Astro.cache?.enabled && nav.cacheHint) Astro.cache.set(nav.cacheHint);
// Said out loud, on the server, on every request that hits the fallback.
// A masthead quietly serving three links instead of five is a fact an operator
// needs and a reader does not; this is where the operator finds out.
if (nav.source === "fallback") {
	console.warn(`masthead: falling back to the built-in links — ${nav.note}`);
}
const current = Astro.url.pathname;
const isCurrent = (href: string) => isCurrentLink(current, href);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="manifest" href="/site.webmanifest" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Asset Hunter — new possibilities"
			href="/rss.xml"
		/>
		<meta name="theme-color" content="#08090a" />
		<meta name="color-scheme" content="dark" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Asset Hunter" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogUrl} />

		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={description} />

		<link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to catalogue</a>

		{
			!bare && (
				<header class="masthead">
					<div class="masthead__inner shell">
						<a class="brand" href="/" aria-label="Asset Hunter — home">
							{/*
							 * `decorative` because the link's own `aria-label` already
							 * says "Asset Hunter — home". Labelling the mark as well
							 * would make a screen reader read the same name twice out
							 * of the same link, and the wordmark beside it is real text.
							 */}
							<Wordmark size={20} decorative />
							<span class="brand__name">Asset Hunter</span>
						</a>
						<nav class="nav" aria-label="Primary" data-nav-source={nav.source}>
							<ul data-scroll-strip>
								{nav.links.map((item) => (
									<li>
										<a
											href={item.href}
											class="nav__link"
											aria-current={isCurrent(item.href) ? "page" : undefined}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
						<form class="search" action="/search" method="get" role="search">
							<label class="visually-hidden" for="q">
								Search possibilities
							</label>
							<input
								id="q"
								type="search"
								name="q"
								placeholder="Search"
								autocomplete="off"
								spellcheck="false"
							/>
							<kbd class="search__kbd" aria-hidden="true">/</kbd>
						</form>
					</div>
				</header>
			)
		}

		{/*
		 * Right here, immediately after the masthead, and inline.
		 *
		 * The masthead's height is a measurement — the nav drops to its own row
		 * below 860px, and at 200% text the header is 113px — so the offsets that
		 * depend on it cannot be a number in the stylesheet. `--masthead-h` is read
		 * by the wall's sticky filter rail and by every in-page anchor's
		 * `scroll-margin`.
		 *
		 * It has to run *synchronously during parsing*, before the browser performs
		 * the fragment scroll on load, which is why it is here and why it is
		 * `is:inline`: Astro bundles a module script and defers it to after the
		 * scroll, and the fallback token was in force at the moment the offset was
		 * needed — measured, `/possibilities/…#signals` landed 74px under the
		 * masthead on an 844×390 phone. `ResizeObserver` then keeps it right for
		 * zoom, rotation and font swaps.
		 *
		 * Nothing depends on this having run: every consumer has a token default,
		 * so a reader without script gets the design's own number.
		 */}
		<script is:inline>
			(function () {
				var masthead = document.querySelector(".masthead");
				if (!masthead) return;
				var publish = function () {
					var height = Math.round(masthead.getBoundingClientRect().height);
					if (height > 0) {
						document.documentElement.style.setProperty("--masthead-h", height + "px");
					}
				};
				publish();
				if ("ResizeObserver" in window) new ResizeObserver(publish).observe(masthead);
				if (document.fonts && document.fonts.ready) document.fonts.ready.then(publish);
				addEventListener("resize", publish, { passive: true });
			})();
		</script>

		<main id="main">
			<slot />
		</main>

		{
			!bare && (
				<footer class="footer">
					<div class="shell footer__inner">
						<div class="footer__brand">
							<Wordmark size={18} />
							<p class="footer__tagline">
								A discovery engine for creative and technical possibilities.
							</p>
						</div>
						<div class="footer__cols">
							{/*
							 * The same CMS menu as the masthead rather than a second
							 * hand-written copy of it — the duplication #17 was about.
							 * The one addition is the reader's own board, which is a
							 * cookie-backed personal surface rather than site
							 * navigation, so it is deliberately not in the admin's menu.
							 */}
							<div>
								<h2 class="tag">Catalogue</h2>
								<ul>
									{nav.links.map((item) => (
										<li><a href={item.href}>{item.label}</a></li>
									))}
									<li><a href="/board">Your shortlist</a></li>
								</ul>
							</div>
							<div>
								<h2 class="tag">Rights</h2>
								<ul>
									<li><a href="/pages/licensing">How we classify</a></li>
									{/*
									 * `#the-statuses`, not `#statuses`. `pages/[slug].astro`
									 * derives heading ids from the heading *text*, and the section
									 * reads "The statuses", so the short form was a link to an id
									 * that does not exist — on every page, in the footer. Found by the
									 * in-page-anchor check in `scripts/visual-qa.mjs`, which
									 * asserts the target exists rather than trusting the href.
									 */}
									<li><a href="/pages/licensing#the-statuses">The four statuses</a></li>
								</ul>
							</div>
							{/*
							 * Utility links, deliberately *not* the CMS menu.
							 *
							 * The "Catalogue" column above is the menu, so an admin
							 * edit moves both. These are the links that have to be
							 * there whatever the menu says — the rights explanation,
							 * the project pages, the feed and the source — and putting
							 * an obligation in an editor's list is how a licence page
							 * goes missing. The quick start lives here rather than in
							 * the primary menu for the same reason: running a hunt is
							 * a project activity, not a browsing one, and the primary
							 * navigation is for browsing.
							 *
							 * Nothing in this column may also be in the menu. "What
							 * this is" and the gallery were both here and in the
							 * menu at the same time, so the footer listed them
							 * twice; the menu renders the Catalogue column, and
							 * repeating it here is the duplication this change
							 * exists to remove rather than to cause.
							 */}
							<div>
								<h2 class="tag">Project</h2>
								<ul>
									<li><a href="/pages/quickstart">Run it locally</a></li>
									<li><a href="/rss.xml">RSS feed</a></li>
									<li><a href="https://github.com/loftwah/asset-hunter">Source</a></li>
								</ul>
							</div>
						</div>
					</div>
					<p class="footer__legal shell">
						Reference-only material is never presented as cleared for use. Always read the
						licence on the source asset.
					</p>
				</footer>
			)
		}

		<script>
			// "/" focuses search from anywhere outside a field, which is the
			// convention for a catalogue with a command palette.
			const focusSearch = (event: KeyboardEvent) => {
				if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
				const target = event.target as HTMLElement | null;
				const tag = target?.tagName;
				if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || target?.isContentEditable) {
					return;
				}
				const input = document.getElementById("q") as HTMLInputElement | null;
				if (!input) return;
				event.preventDefault();
				input.focus();
				input.select();
			};
			document.addEventListener("keydown", focusSearch);

			/**
			 * Horizontally scrolling strips (primary nav, filter rail) are clipped
			 * at the shell edge by design, which reads as a broken layout unless
			 * something says the strip continues. This marks which edges have more
			 * content so the stylesheet can fade exactly those, and nothing else —
			 * a fade on a strip that already fits would be a lie.
			 */
			const scrollers = () =>
				Array.from(
					document.querySelectorAll<HTMLElement>("[data-scroll-strip]"),
				);

			const updateStrip = (el: HTMLElement) => {
				const overflow = el.scrollWidth - el.clientWidth;
				if (overflow <= 1) {
					el.dataset.scroll = "none";
					return;
				}
				const atStart = el.scrollLeft <= 1;
				const atEnd = el.scrollLeft >= overflow - 1;
				el.dataset.scroll = atStart ? "end" : atEnd ? "start" : "both";
			};

			const syncStrips = () => {
				for (const el of scrollers()) updateStrip(el);
			};

			for (const el of scrollers()) {
				updateStrip(el);
				el.addEventListener("scroll", () => updateStrip(el), { passive: true });
			}
			addEventListener("resize", syncStrips, { passive: true });
			// A late webfont swap changes the width of every chip, so the first
			// measurement can be wrong.
			document.fonts?.ready.then(syncStrips);
		</script>
	</body>
</html>

<style>
	.masthead {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--canvas) 88%, transparent);
		backdrop-filter: blur(14px) saturate(140%);
		border-bottom: 1px solid var(--line);
	}

	.masthead__inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--sp-5);
		min-height: 3.5rem;
	}

	/*
	 * `min-width: 0` on both the nav and its list is the whole reason the primary
	 * navigation scrolls instead of widening the page. A grid item's default
	 * `min-width: auto` refuses to shrink below the content, so at 200% text —
	 * where the five links need more than the column has — the column grew, the
	 * page gained 114px of horizontal scroll, and the strip's own
	 * `overflow-x: auto` never engaged. Zero specificity here means a component
	 * can still override it deliberately.
	 */
	.nav {
		min-width: 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.75rem;
		color: var(--ink);
	}

	.brand__name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-0);
		letter-spacing: -0.015em;
		white-space: nowrap;
	}

	.nav ul {
		display: flex;
		align-items: center;
		gap: clamp(0.5rem, 1.4vw, 1.5rem);
		list-style: none;
		padding: 0;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		/* A keyboard user scrolling the strip with the arrow keys should land on
		   links, not on a page scroll: the strip is the thing that scrolls. */
		overscroll-behavior-inline: contain;
	}

	.nav ul::-webkit-scrollbar {
		display: none;
	}

	/* Scroll affordance: only the edge with hidden content is faded. */
	.nav ul[data-scroll="end"] {
		mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
	}

	.nav ul[data-scroll="start"] {
		mask-image: linear-gradient(to right, transparent, #000 2.5rem);
	}

	.nav ul[data-scroll="both"] {
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 2.5rem,
			#000 calc(100% - 2.5rem),
			transparent
		);
	}

	.nav__link {
		display: inline-block;
		/* Padding rather than type size carries the touch target (DESIGN.md §7):
		   the nav type is intentionally small, and a 37px-high link with five
		   siblings is five mis-taps on a phone. */
		padding: 0.85rem 0;
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
		white-space: nowrap;
		border-bottom: 1px solid transparent;
		transition: color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	.nav__link:hover {
		color: var(--ink);
	}

	.nav__link[aria-current="page"] {
		color: var(--ink);
		border-bottom-color: var(--ember);
	}

	.search {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search input {
		width: clamp(7rem, 14vw, 12rem);
		min-height: var(--tap);
		padding: 0.4rem 2rem 0.4rem 0.7rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		transition: border-color var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out);
	}

	.search input::placeholder {
		color: var(--ink-4);
	}

	.search input:focus {
		border-color: var(--line-loud);
		background: var(--surface-2);
	}

	.search input::-webkit-search-cancel-button {
		filter: invert(0.6);
	}

	.search__kbd {
		position: absolute;
		right: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--ink-4);
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 2px;
		padding: 0 0.3em;
		pointer-events: none;
	}

	@media (width <= 860px) {
		.masthead__inner {
			grid-template-columns: 1fr auto;
			row-gap: 0;
		}

		.nav {
			order: 3;
			grid-column: 1 / -1;
			padding-bottom: 0.35rem;
			/* Full-bleed to the shell's own edge, so the strip can scroll to the
			   real edge of the screen. The safe area is part of that edge. */
			margin-inline: calc(var(--shell-pad-l) * -1) calc(var(--shell-pad-r) * -1);
			padding-inline: var(--shell-pad-l) var(--shell-pad-r);
		}

		.search__kbd {
			display: none;
		}

		/* Wide enough for the full placeholder: a clipped label in a field
		   that cannot show it is worse than no field. */
		.search input {
			width: 8.5rem;
			padding-right: 0.7rem;
		}

		.search input:focus {
			width: clamp(9rem, 40vw, 14rem);
		}
	}

	@media (width <= 400px) {
		.brand__name {
			font-size: var(--step--1);
		}

		.search input {
			width: 7.5rem;
		}
	}

	/*
	 * A phone in landscape has ~390px of height and the width of a small laptop,
	 * and the width breakpoint above sends the nav to a second row — 43px of a
	 * window that is already mostly chrome. Height is the scarce resource here,
	 * not width, so a short viewport keeps the single row even below 860px. The
	 * nav column is `minmax(0, 1fr)` and its list scrolls, so it shrinks rather
	 * than overflowing.
	 */
	@media (width <= 860px) and (height <= 30rem) {
		.masthead__inner {
			grid-template-columns: auto minmax(0, 1fr) auto;
		}

		.nav {
			order: 0;
			grid-column: auto;
			padding-bottom: 0;
			margin-inline: 0;
			padding-inline: 0;
		}
	}

	.footer {
		margin-top: var(--sp-9);
		border-top: 1px solid var(--line);
		padding-top: var(--sp-6);
		background: var(--surface);
	}

	.footer__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: var(--sp-6);
		padding-bottom: var(--sp-6);
	}

	.footer__brand {
		display: flex;
		flex-direction: column;
		gap: var(--sp-3);
		color: var(--ink-3);
	}

	.footer__tagline {
		font-size: var(--step--1);
		max-width: 28ch;
		color: var(--ink-3);
	}

	.footer__cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--sp-5);
	}

	.footer__cols h2 {
		margin-bottom: var(--sp-3);
	}

	.footer__cols ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--sp-2);
	}

	/* Inline footer links get a real tap target: the text is small, so the
	   padding — not the type size — has to carry the 44px minimum. */
	.footer__cols a {
		display: inline-block;
		padding-block: 0.35rem;
		min-height: var(--tap);
		font-size: var(--step--1);
		color: var(--ink-2);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.footer__cols a:hover {
		color: var(--ink);
	}

	.footer__legal {
		padding-block: var(--sp-4);
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--ink-4);
		letter-spacing: 0.02em;
	}

	@media (width <= 760px) {
		.footer__inner {
			grid-template-columns: 1fr;
		}

		.footer__cols {
			grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
			gap: var(--sp-5) var(--sp-4);
		}
	}
</style>
