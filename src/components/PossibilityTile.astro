---
/**
 * A single tile on the catalogue wall.
 *
 * Design intent: the specimen is the content and the type is a label, not a
 * summary. The whole tile is one link so the hit area is the media, which is
 * both a larger target and a more honest affordance than a small text link.
 *
 * The state props exist because every one of those states is a real answer the
 * catalogue has to be able to give (DESIGN.md §8), and `src/pages/lab.astro`
 * renders them with this component rather than in a mockup. A state that only
 * exists as a screenshot is a state nobody has checked.
 */
import ProvenanceMarkers from "./ProvenanceMarkers.astro";
import { MEDIA_LABEL, verticalLabel } from "../lib/vocabulary";
import { mediaSrc, type Possibility } from "../lib/catalogue";

interface Props {
	possibility: Possibility;
	/** Above this index, show the specimen larger — the density ramp. */
	featured?: boolean;
	/** Dominant vertical across the current view; hidden on that tile. */
	hideVertical?: boolean;
	eager?: boolean;
	/**
	 * Heading level for the tile title. Must match the page hierarchy: an
	 * `h3` under an `h1` with no intervening `h2` is a skipped level, which
	 * breaks screen-reader navigation.
	 */
	headingLevel?: "h2" | "h3";
	/** Shortlisted or compared. Rendered as a marker, never as a colour alone. */
	saved?: boolean;
	/** Chosen on the shortlist board. */
	selected?: boolean;
	/** Media is still arriving. Geometry is reserved so nothing jumps. */
	loading?: boolean;
	/** The preview failed. Named, with what to do next. */
	brokenPreview?: boolean;
	/** The upstream source is gone or unreachable. */
	deadSource?: boolean;
	/** Force hover styling without a pointer, for screenshots. */
	forceHover?: boolean;
	/** Force the focus ring, for screenshots. */
	forceFocus?: boolean;
	/** `href` override, so a lab fixture does not link to a real page. */
	href?: string | null;
	/**
	 * The board to save into. Absent means "no save control" — the lab does not
	 * want one, because a fixture that saved itself would be a fixture that
	 * writes to the reader's cookie.
	 */
	board?: string | null;
	/** Whether this possibility is already on that board. */
	savedToBoard?: boolean;
}

const {
	possibility: p,
	featured = false,
	hideVertical = false,
	eager = false,
	headingLevel = "h3",
	saved = false,
	selected = false,
	loading = false,
	brokenPreview = false,
	deadSource = false,
	forceHover = false,
	forceFocus = false,
	href,
	board = null,
	savedToBoard = false,
} = Astro.props;
const Heading = headingLevel;
// Exposed so the wall's client-side filter can hide non-matching tiles without
// a second request, and so the DOM order still reflects the server ordering.
const verticalAttr = p.vertical ?? "";
const src = mediaSrc(p);
const vertical = p.vertical ? verticalLabel(p.vertical) : null;
// A tile with nothing to show says so rather than rendering an empty frame.
const hasPlate = Boolean(p.image?.src || p.specimen);
const status = brokenPreview ? "broken" : loading ? "loading" : null;
---

<article
	class:list={[
		"tile",
		{ "tile--featured": featured, "tile--saved": saved, "tile--selected": selected },
	]}
	data-vertical={verticalAttr}
>
	<a
		class:list={["tile__link", { "is-hovered": forceHover, "is-focused": forceFocus }]}
		href={href === null ? undefined : (href ?? `/possibilities/${p.slug}`)}
		aria-disabled={href === null ? "true" : undefined}
		tabindex={href === null ? -1 : undefined}
	>
		<div class="tile__plate" data-state={status ?? undefined}>
			{
				hasPlate ? (
					<>
						{/*
						 * The plate's alt is empty on purpose.
						 *
						 * It used to be `"{title} — {tagline}"`, inside a link whose next
						 * node is a heading with the same title. The accessibility tree
						 * then read: link "Crowds that move as a fluid, not as agents —
						 * Screen-space density field…  Crowds that move as a fluid, not as
						 * agents  Games  Code  Reference only  Generated" — the name
						 * twice, once with the tagline attached to it, on every one of
						 * twenty-four tiles. That is the wrong answer for a screen reader
						 * and for anyone who navigates by link list.
						 *
						 * So the image is a decorative cover of an entry the link already
						 * names (WCAG's own case for `alt=""`), and the tagline — which
						 * would otherwise have reached a screen reader only through that
						 * alt — is kept as visually hidden text in the same link. Nothing is
						 * announced twice and nothing is lost. The drill-in's `<figure>`
						 * keeps a descriptive alt because there the image stands alone next
						 * to a caption rather than inside a link.
						*/}
						<img
							src={src}
							alt=""
							width="800"
							height="1000"
							loading={eager || loading ? "eager" : "lazy"}
							decoding="async"
							fetchpriority={eager ? "high" : "auto"}
						/>
					</>
				) : (
					<span class="tile__absent">
						<span class="tag">No plate</span>
						<span>Nothing has been generated for this entry yet.</span>
					</span>
				)
			}
			{
				loading && (
					<span class="tile__loading" aria-hidden="true">
						<span class="tile__loading-bar" />
					</span>
				)
			}
			{
				(saved || selected) && (
					<span class="tile__flags">
						{selected && (
							<span class="tag tile__flag tile__flag--selected">On board</span>
						)}
						{saved && <span class="tag tile__flag">Saved</span>}
					</span>
				)
			}
		</div>

		<div class="tile__label">
			<Heading class="tile__title">{p.title}</Heading>
			{/*
			 * The tagline, for anyone not looking at the plate. It sat on the
			 * image's `alt` before, which put it in front of the title in the link's
			 * accessible name; here it follows the heading, so the name reads the
			 * way the tile looks — title, then what it is, then where it sits.
			 */}
			{p.tagline && <span class="visually-hidden">{p.tagline}</span>}
			{
				!hideVertical && vertical && (
					<p class="tile__meta">
						<span class="tag">{vertical}</span>
						{p.mediaKind && <span class="tag">{MEDIA_LABEL[p.mediaKind] ?? p.mediaKind}</span>}
					</p>
				)
			}
			<ProvenanceMarkers rights={p.rightsStatus} origin={p.representativeOrigin} size="sm" />

			{
				(brokenPreview || deadSource) && (
					<p class="tile__notice" role="status">
						{brokenPreview
							? "Preview failed to load. The entry and its rights are unaffected."
							: "The upstream source is no longer reachable. The evidence recorded here is what was read at the time."}
					</p>
				)
			}
		</div>
	</a>

	{
		board && (
			<form class="save" method="post" action="/api/board">
				<input type="hidden" name="action" value={savedToBoard ? "unsave" : "save"} />
				<input type="hidden" name="slug" value={p.slug} />
				<input type="hidden" name="board" value={board} />
				<input type="hidden" name="back" value={Astro.url.pathname + Astro.url.search} />
				<button
					type="submit"
					class:list={["save__button", { "save__button--on": savedToBoard }]}
					aria-pressed={savedToBoard ? "true" : "false"}
				>
					<span class="save__glyph" aria-hidden="true">{savedToBoard ? "✓" : "+"}</span>
					<span class="visually-hidden">
						{savedToBoard ? `Remove ${p.title} from ${board}` : `Save ${p.title} to ${board}`}
					</span>
				</button>
			</form>
		)
	}
</article>

<style>
	.tile {
		position: relative;
	}

	.tile__link {
		display: grid;
		gap: var(--sp-3);
		/* Whole tile is the target: a bigger, more honest hit area. */
		min-height: 44px;
	}

	.tile__plate {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--shadow-plate);
		aspect-ratio: 4 / 5;
		transition: border-color var(--dur) var(--ease-out),
			transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
	}

	.tile__plate img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-out),
			opacity var(--dur) var(--ease-out);
	}

	/* Hover/focus: lift the plate and warm the border. No drop-shadow soup. */
	.tile__link:hover .tile__plate,
	.tile__link:focus-visible .tile__plate,
	.tile__link.is-hovered .tile__plate,
	.tile__link.is-focused .tile__plate {
		border-color: var(--ember-line);
		transform: translateY(-2px);
		box-shadow: var(--shadow-lift);
	}

	.tile__link:hover .tile__plate img,
	.tile__link.is-hovered .tile__plate img {
		transform: scale(1.028);
	}

	.tile__link:focus-visible,
	.tile__link.is-focused {
		outline: 2px solid var(--ember);
		outline-offset: 4px;
		border-radius: var(--radius);
	}

	/* --- States ----------------------------------------------------------- */

	/* A tile that is on the shortlist board or saved reads as selected without
	   shouting: an inset ring rather than a fill, so the plate stays the thing
	   being looked at. */
	.tile--selected .tile__plate {
		box-shadow: inset 0 0 0 2px var(--ember);
	}

	.tile--saved .tile__plate {
		border-color: var(--line-loud);
	}

	/* Loading: the geometry is already reserved by the aspect ratio, so a
	   shimmer over an empty plate never moves the page. */
	.tile__plate[data-state="loading"] img {
		opacity: 0.18;
	}

	.tile__loading {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
	}

	.tile__loading-bar {
		width: 42%;
		height: 2px;
		background: var(--ember);
		opacity: 0.75;
	}

	.tile__plate[data-state="broken"] img {
		opacity: 0.22;
		filter: grayscale(1);
	}

	.tile__plate[data-state="broken"]::after {
		content: "Preview unavailable";
		position: absolute;
		inset: auto 0 1rem;
		text-align: center;
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.tile__absent {
		display: grid;
		place-content: center;
		gap: var(--sp-2);
		height: 100%;
		padding: var(--sp-4);
		text-align: center;
		font-size: var(--step--2);
		color: var(--ink-4);
		background: repeating-linear-gradient(
			-45deg,
			var(--surface) 0 8px,
			var(--surface-2) 8px 16px
		);
	}

	.tile__flags {
		position: absolute;
		top: var(--sp-2);
		left: var(--sp-2);
		display: flex;
		gap: var(--sp-2);
	}

	.tile__flag {
		padding: 0.15rem 0.45rem;
		background: var(--canvas);
		border: 1px solid var(--line-loud);
		border-radius: 999px;
		color: var(--ink-2);
	}

	.tile__flag--selected {
		border-color: var(--ember);
		color: var(--ember);
	}

	.tile__notice {
		font-size: var(--step--2);
		line-height: 1.45;
		color: var(--ink-3);
		border-left: 2px solid var(--ember-line);
		padding-left: var(--sp-3);
	}

	/* --- Save control ----------------------------------------------------- */

	/* Positioned over the plate rather than inside the link: a form inside an
	   anchor is invalid, and a button inside a link is unusable with a pointer
	   and unreachable with a keyboard. It is a sibling, so both stay honest. */
	.save {
		position: absolute;
		top: var(--sp-2);
		right: var(--sp-2);
		z-index: 2;
	}

	.save__button {
		display: grid;
		place-items: center;
		/* 32px was the old size and it sat over the corner of every plate on a
		   phone, where the neighbouring tile link is 44px away and the tap lands
		   on whichever the thumb covers first. The plate is the target underneath,
		   so the control has to be the full floor to be unambiguous. */
		width: var(--tap);
		height: var(--tap);
		background: color-mix(in srgb, var(--canvas) 82%, transparent);
		border: 1px solid var(--line-loud);
		border-radius: 999px;
		color: var(--ink-2);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out);
	}

	/* Kept visible on touch, where there is no hover to reveal it, and dimmed
	   rather than hidden on a pointer so the wall does not gain a row of
	   buttons. */
	@media (hover: hover) and (pointer: fine) {
		.save__button {
			opacity: 0;
		}

		.tile:hover .save__button,
		.save__button:focus-visible,
		.save__button--on {
			opacity: 1;
		}
	}

	.save__button:hover {
		color: var(--ink);
		border-color: var(--ember-line);
	}

	.save__button--on {
		color: var(--canvas);
		background: var(--ember);
		border-color: var(--ember);
	}

	.save__glyph {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1;
	}

	/* --- Label ------------------------------------------------------------ */

	.tile__label {
		display: grid;
		gap: var(--sp-2);
		align-content: start;
	}

	.tile__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-0);
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: balance;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.tile__link:hover .tile__title,
	.tile__link.is-hovered .tile__title {
		color: var(--ember);
	}

	.tile__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2) var(--sp-3);
	}

	/* The featured tile earns its size from the wall's grid, not from a shape of
	   its own. Every specimen plate is a 4:5 diagram whose meaning often sits in
	   an annotation near an edge, so a wider crop hides content rather than
	   framing it. `npm run check:visual` asserts the rendered ratio. */
	@media (width >= 900px) {
		.tile--featured .tile__title {
			font-size: var(--step-2);
		}
	}
</style>