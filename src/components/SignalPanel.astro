---
/**
 * The three signals and the report form for one subject (#37).
 *
 * Extracted from `possibilities/[slug].astro` so the lab can render the real
 * thing. Before this existed the rating and report states could only be seen by
 * signing in to a running CMS and finding an entry somebody had already rated —
 * so five of the states a reader can land in had no pixels anywhere, and "the
 * rate form is fine" was a belief rather than an observation. The same component
 * renders on the drill-in and in `src/pages/lab.astro`, which is the only way a
 * fixture proves anything: a mockup of a form proves that the mockup works.
 *
 * Three signals, three named places, never one blended number, because a
 * reader's stars, a curator's judgement and an inspection result are three
 * different kinds of claim.
 *
 * Everything here is a pure function of its props: the page passes the
 * aggregate, the viewer and the unresolved reports it already loaded, and this
 * component reads no CMS itself. That is what makes a fixture of it honest.
 */
import {
	REPORTS,
	REPORT_REASONS,
	SIGNAL_MEANING,
	ratingSummary,
	type Aggregate,
	type Report,
	type ReportReason,
	type SubjectType,
} from "../lib/rating.ts";
import type { Actor } from "../lib/signals.ts";

interface Props {
	subjectType: SubjectType;
	subjectSlug: string;
	/** EmDash's authenticated user, or null when signed out. */
	viewer: Actor | null;
	/** Community ratings for this subject. */
	community: Aggregate;
	/** Reports filed against this subject with no resolution yet. */
	openReports?: Report[];
	/** Noun for the thing being rated, used in the screen-reader legend. */
	subjectLabel?: string;
	/**
	 * Distinguishes this panel's element ids from another panel's on the same
	 * page.
	 *
	 * The panel hard-codes `signals`, `report`, `reason-<slug>` and
	 * `detail-<slug>`, which is unique as long as there is one panel per page —
	 * and `/lab` renders all seven states at once, so every `id` was duplicated
	 * eight, seven and seven times and every `<label for>` on the page pointed at
	 * the *first* panel's controls. A screen reader on the lab was told the sixth
	 * form's label was the first form's reason list.
	 *
	 * **Unset, deliberately**, for a page that has one panel: `signals` and
	 * `report` are then still exactly that, because
	 * `/possibilities/<slug>#signals` is a real link — the masthead, the
	 * breadcrumbs and `scripts/visual-qa.mjs` all use it, and a heading id that
	 * changes under an existing fragment is a broken link nobody chose. Scoping
	 * only when a caller asks for it fixes the duplication without moving
	 * anything.
	 */
	idScope?: string | null;
}

const {
	subjectType,
	subjectSlug,
	viewer,
	community,
	openReports = [],
	subjectLabel = "entry",
	idScope = null,
} = Astro.props;

const back = subjectType === "possibility" ? `/possibilities/${subjectSlug}` : "/";

/*
 * Ids for this instance. `idScope` is null on a page with one panel, where
 * `signals` and `report` stay exactly that so the existing
 * `/possibilities/<slug>#signals` fragment keeps resolving.
 */
const ids = {
	signals: idScope ? `signals-${idScope}` : "signals",
	report: idScope ? `report-${idScope}` : "report",
	reason: idScope ? `reason-${idScope}` : `reason-${subjectSlug}`,
	detail: idScope ? `detail-${idScope}` : `detail-${subjectSlug}`,
};

/*
 * Where signing in actually is.
 *
 * Both refusals here used to be a dead end in words: "signing in is required",
 * with no route, on a page whose whole job is to let a reader have an opinion.
 * That is the keyboard journey failing at its last step — a reader who cannot
 * rate is told why and then left.
 *
 * It is EmDash's own entry point, not a second one invented here: `/_emdash/admin`
 * is the sign-in screen when there is no session and the CMS when there is, which
 * is the same identity `Astro.locals.user` comes from. The architecture forbids a
 * parallel auth stack and this is the opposite of one.
 */
const SIGN_IN = "/_emdash/admin";
---

<section aria-labelledby={ids.signals} class="signals">
	<h2 id={ids.signals} class="section__title">Signals</h2>

	<div class="signal">
		<p class="signal__head">
			<span class="tag">Community</span>
			<span class="signal__value">{ratingSummary(community)}</span>
		</p>
		<p class="signal__meaning">{SIGNAL_MEANING.community}</p>
		{
			community.count > 0 && (
				<ul class="dist" aria-label={`Rating distribution for this ${subjectLabel}`}>
					{[5, 4, 3, 2, 1].map((star) => {
						const n = community.distribution[star];
						const pct = community.count ? Math.round((n / community.count) * 100) : 0;
						return (
							<li class="dist__row">
								<span class="tag">{star}★</span>
								<span class="dist__bar" aria-hidden="true">
									<span class="dist__fill" style={`width:${pct}%`} />
								</span>
								<span class="dist__n">{n}</span>
							</li>
						);
					})}
				</ul>
			)
		}
		<form class="rate" method="post" action="/api/signal">
			<input type="hidden" name="intent" value="rate" />
			<input type="hidden" name="subject_type" value={subjectType} />
			<input type="hidden" name="subject_slug" value={subjectSlug} />
			<input type="hidden" name="back" value={back} />
			<fieldset>
				<legend class="tag">Rate it</legend>
				{[1, 2, 3, 4, 5].map((star) => (
					<label class="rate__star">
						<input
							type="radio"
							name="stars"
							value={star}
							checked={community.mine === star}
							required={!viewer}
						/>
						<span aria-hidden="true">★</span>
						<span class="visually-hidden">{star} of 5</span>
					</label>
				))}
				<button type="submit" disabled={!viewer}>
					{community.mine ? "Change" : "Rate"}
				</button>
			</fieldset>
		</form>
		{
			/* The withdraw control, and only for a reader who has something to withdraw.
			   It is the other half of the sentence below: that copy has always argued a
			   rating must be revisable and withdrawable, and only the revising existed. */
			viewer && community.mine !== null && (
				<form class="rate rate--withdraw" method="post" action="/api/signal">
					<input type="hidden" name="intent" value="withdraw" />
					<input type="hidden" name="subject_type" value={subjectType} />
					<input type="hidden" name="subject_slug" value={subjectSlug} />
					<input type="hidden" name="back" value={back} />
					<button type="submit" class="rate__withdraw">
						Withdraw your {community.mine}★ rating
					</button>
				</form>
			)
		}
		{
			!viewer && (
				<p class="signal__note">
					A rating you cannot revise or withdraw is not an opinion, it is a vote, so signing in
					is required. <a href={SIGN_IN}>Sign in</a> to rate this {subjectLabel}.
				</p>
			)
		}
	</div>

	<div class="signal">
		<p class="signal__head">
			<span class="tag">Editorial</span>
			<!--
				A person's decision in the admin. The lab renders the panel with no
				possibility behind it, so the value has to be passable rather than
				read off a record that does not exist.
			-->
			<slot name="editorial">
				<span class="signal__value">Not featured</span>
			</slot>
		</p>
		<p class="signal__meaning">{SIGNAL_MEANING.editorial}</p>
		<slot name="editorial-note">
			<p class="signal__note">
				A person's decision, made in the admin. It is not popularity, and it does not move when
				ratings move.
			</p>
		</slot>
	</div>

	<div class="signal">
		<p class="signal__head">
			<span class="tag">Machine</span>
			<!-- Same reason as the editorial block: the fixture has no record to read. -->
			<slot name="machine">
				<span class="signal__value">Not measured</span>
			</slot>
		</p>
		<p class="signal__meaning">{SIGNAL_MEANING.machine}</p>
		<slot name="machine-note">
			<p class="signal__note">
				No source has had its licence read yet, so there is nothing to measure against.
			</p>
		</slot>
	</div>
</section>

<section aria-labelledby={ids.report} class="report">
	<h2 id={ids.report} class="section__title">Report a problem</h2>
	<p class="report__why">
		A report is not a low rating. Use it when something here is wrong rather than bad, and a
		licence concern is read before anything else.
	</p>
	<form class="report__form" method="post" action="/api/signal">
		{/* The disabled state lives on the fieldset, not on the form: a
		    disabled form cannot be submitted at all, which turns "you need
		    to sign in" into a button that silently does nothing. */}
		<fieldset disabled={!viewer}>
			<legend class="visually-hidden">File a report about this {subjectLabel}</legend>
			<input type="hidden" name="intent" value="report" />
			<input type="hidden" name="subject_type" value={subjectType} />
			<input type="hidden" name="subject_slug" value={subjectSlug} />
			<input type="hidden" name="back" value={back} />
			<label class="report__label tag" for={ids.reason}>What is wrong</label>
			<select id={ids.reason} name="reason">
				{REPORT_REASONS.map((reason) => (
					<option value={reason}>{REPORTS[reason].label}</option>
				))}
			</select>
			<p class="report__reason-meaning">
				{/* About the licence reason specifically, not about whichever option is
				    selected: without JavaScript there is nothing to switch this, and
				    a description that does not match the open option is worse than
				    none. */}
				A licence concern is read before anything else here. If the status no longer matches
				what the source says, that is a correction rather than a preference.
			</p>
			<label class="report__label tag" for={ids.detail}>
				Details (optional)
			</label>
			<textarea
				id={ids.detail}
				name="detail"
				rows="3"
				maxlength="2000"
				placeholder="What you saw, and where. One line is enough to act on."
			/>
			<button type="submit">File the report</button>
		</fieldset>
	</form>
	{
		!viewer && (
			<p class="signal__note">
				Filing needs a sign-in, because a report nobody can answer is worse than no report.
				<a href={SIGN_IN}>Sign in</a> to file one. With no account at all, the
				<a href="/pages/licensing">licensing page</a> carries the contact route.
			</p>
		)
	}
	{
		openReports.length > 0 && (
			<p class="report__open">
				{openReports.length} open report{openReports.length === 1 ? "" : "s"} on this {subjectLabel}.
			</p>
		)
	}
</section>

<style>
	.signals {
		display: grid;
		gap: var(--sp-4);
		margin-top: var(--sp-2);
	}

	.signal {
		display: grid;
		gap: var(--sp-2);
		padding: var(--sp-4);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.signal__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--sp-2) var(--sp-4);
	}

	.signal__value {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step--1);
		color: var(--ink);
		text-align: right;
	}

	.signal__meaning,
	.signal__note {
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--ink-3);
	}

	/* An inline link inside a sentence is still a target: the padding carries the
	   size, not the type, which is why the rule exists everywhere else too. */
	.signal__note a,
	.report__why a {
		display: inline-block;
		min-height: 1.5rem;
		padding-block: 0.2rem;
		color: var(--ember);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.dist {
		display: grid;
		gap: 0.2rem;
		list-style: none;
		padding: 0;
		margin-block: var(--sp-2);
	}

	.dist__row {
		display: grid;
		grid-template-columns: 2.25rem 1fr 1.5rem;
		align-items: center;
		gap: var(--sp-2);
	}

	.dist__bar {
		height: 3px;
		background: var(--surface-3);
		border-radius: 2px;
		overflow: hidden;
	}

	.dist__fill {
		display: block;
		height: 100%;
		background: var(--ember-dim);
	}

	.dist__n {
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--ink-4);
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	.rate fieldset {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--sp-2);
		border: 0;
		padding: 0;
		margin: 0;
	}

	.rate legend {
		padding: 0;
		margin-bottom: var(--sp-2);
	}

	.rate__star {
		position: relative;
		display: grid;
		place-items: center;
		/* A 36px star next to a 44px neighbour is a mis-tap that records the
		   wrong opinion about somebody's work, so the floor is the full one. */
		width: var(--tap);
		height: var(--tap);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink-4);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	.rate__star:hover {
		color: var(--ember);
		border-color: var(--ember-line);
	}

	/* The radio covers its label rather than being shrunk to nothing. A 1x1
	   input is still reachable by keyboard but is not a target a finger can
	   hit, and it is invisible to the tap-target audit that way. */
	.rate__star input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: pointer;
	}

	.rate__star:has(input:checked) {
		color: var(--ember);
		border-color: var(--ember);
	}

	.rate__star:has(input:focus-visible) {
		outline: 2px solid var(--ember);
		outline-offset: 3px;
	}

	/*
	 * The withdraw control is deliberately quieter than the rate button and sits under
	 * the fieldset rather than inside it: it is the opposite action, and a reader who
	 * wants it should find it without a second button competing with "Change" for the
	 * eye. `--quiet` keeps the tap target — a 32px control is below WCAG 2.5.8's floor
	 * and the visual QA matrix measures that.
	 */
	.rate--withdraw {
		margin-top: 0.5rem;
	}

	.rate__withdraw {
		min-height: var(--tap);
		padding: 0.35rem 0.9rem;
		background: transparent;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink-3);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		cursor: pointer;
	}

	.rate__withdraw:hover {
		border-color: var(--line-loud);
		color: var(--ink-2);
	}

	.rate button {
		min-height: var(--tap);
		margin-left: auto;
		padding: 0.35rem 0.9rem;
		background: var(--surface-2);
		border: 1px solid var(--line-loud);
		border-radius: var(--radius);
		color: var(--ink-2);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		cursor: pointer;
	}

	.rate button:hover:not(:disabled) {
		color: var(--ink);
		border-color: var(--ember-line);
	}

	.rate button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	/* --- Report ---------------------------------------------------------- */

	.report {
		margin-top: var(--sp-5);
		padding-top: var(--sp-4);
		border-top: 1px solid var(--line);
	}

	.report__why {
		margin-top: var(--sp-2);
		font-size: var(--step--1);
		color: var(--ink-3);
		max-width: var(--measure);
	}

	.report__form {
		display: grid;
		gap: var(--sp-2);
		margin-top: var(--sp-3);
		max-width: 34rem;
		border: 0;
		padding: 0;
	}

	.report__form fieldset {
		display: grid;
		gap: var(--sp-2);
		border: 0;
		padding: 0;
		margin: 0;
	}

	.report__form fieldset:disabled {
		opacity: 0.55;
	}

	.report__reason-meaning {
		font-size: var(--step--2);
		line-height: 1.5;
		color: var(--ink-4);
		max-width: 44ch;
	}

	.report__label {
		margin-top: var(--sp-2);
	}

	.report__form select,
	.report__form textarea {
		width: 100%;
		min-height: 2.75rem;
		padding: 0.55rem 0.7rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--ink);
		font-family: var(--font-ui);
		font-size: var(--step--1);
	}

	.report__form textarea {
		font-family: var(--font-mono);
		line-height: 1.5;
		resize: vertical;
	}

	.report__form select:focus-visible,
	.report__form textarea:focus-visible {
		border-color: var(--ember-line);
	}

	.report__form button {
		justify-self: start;
		min-height: 2.75rem;
		margin-top: var(--sp-2);
		padding: 0.55rem 1.1rem;
		background: var(--surface-2);
		border: 1px solid var(--line-loud);
		border-radius: var(--radius);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		cursor: pointer;
	}

	.report__form button:hover {
		border-color: var(--ember-line);
	}

	.report__open {
		margin-top: var(--sp-3);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		color: var(--rights-review);
	}
</style>