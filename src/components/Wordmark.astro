---
/**
 * Asset Hunter wordmark. An aperture ring with a single marker — a hunting
 * sight rather than a literal target, so it reads as "locating" and not
 * "bullseye".
 *
 * The geometry lives in `src/lib/brand/mark.ts`, not here. This component used
 * to carry its own copy of the same circles and paths that `public/favicon.svg`
 * carried a second copy of, and the two drifted with nothing to notice: the
 * committed `apple-touch-icon.png` had lost the inner ring entirely. Now both
 * are derived from one module and `tests/brand.test.ts` fails if this file
 * grows a hand-drawn `<circle>` or `<path>` again.
 *
 * Inline rather than an `<img>` so the mark can be drawn in `currentColor` and
 * inherit ink on whatever surface it lands on — the masthead, the footer, a
 * light card. An `<img>` cannot.
 */
import { MARK_BOX, markShapes, type MarkDetail } from "../lib/brand/mark.ts";

interface Props {
	size?: number;
	title?: string;
	/**
	 * Which form to draw. `full` is the mark; `compact` is the icon form, which
	 * is what anything under 32px should use (see `MARK_MIN_SIZE_PX`).
	 */
	detail?: MarkDetail;
	/**
	 * Hide from assistive technology when the surrounding text already names
	 * the thing. The masthead link reads "Asset Hunter — home", so an
	 * `aria-label="Asset Hunter"` inside it is the same sentence twice.
	 */
	decorative?: boolean;
}
const { size = 22, title = "Asset Hunter", detail = "full", decorative = false } = Astro.props;

const shapes = markShapes(detail, "currentColor");
---

<svg
	class="mark"
	width={size}
	height={size}
	viewBox={`0 0 ${MARK_BOX} ${MARK_BOX}`}
	fill="none"
	role={decorative ? "presentation" : "img"}
	aria-label={decorative ? undefined : title}
	aria-hidden={decorative ? "true" : undefined}
>
	{shapes.map(({ tag: Tag, attrs }) => <Tag {...attrs} />)}
</svg>
